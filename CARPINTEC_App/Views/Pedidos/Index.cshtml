                                <td class="p-table-cell-padding">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-primary/30 flex items-center justify-center text-on-surface font-bold text-[12px]">MM</div>
                                        <span>Manuel Morales</span>
                                    </div>
                                </td>
                                <td class="p-table-cell-padding">Juego de Comedor Caoba</td>
