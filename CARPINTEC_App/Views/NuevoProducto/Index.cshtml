@{
    Layout = null;
}

<!DOCTYPE html>
<html class="light" lang="es">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Registrar Nuevo Producto | Carpintec</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&amp;family=Hanken+Grotesk:wght@400;600&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <script id="tailwind-config">
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        "colors": {
                            "primary-fixed": "#ffdbd0",
                            "secondary-container": "#e1e1c9",
                            "inverse-primary": "#e7bdb1",
                            "surface-container-high": "#eae7e7",
                            "on-tertiary-fixed": "#061f1e",
                            "on-secondary-container": "#636451",
                            "on-primary-fixed-variant": "#5d4037",
                            "surface": "#fcf9f8",
                            "tertiary-fixed-dim": "#b1ccc9",
                            "surface-tint": "#77574d",
                            "inverse-on-surface": "#f3f0ef",
                            "surface-container-low": "#f6f3f2",
                            "on-secondary": "#ffffff",
                            "primary": "#442a22",
                            "error-container": "#ffdad6",
                            "surface-variant": "#e5e2e1",
                            "secondary": "#5e604d",
                            "on-surface": "#1b1c1c",
                            "surface-container": "#f0eded",
                            "surface-container-lowest": "#ffffff",
                            "on-tertiary-fixed-variant": "#334b49",
                            "on-secondary-fixed-variant": "#474836",
                            "on-primary-container": "#d4ada1",
                            "background": "#fcf9f8",
                            "inverse-surface": "#303030",
                            "surface-dim": "#dcd9d9",
                            "tertiary-container": "#334b49",
                            "on-surface-variant": "#504441",
                            "primary-fixed-dim": "#e7bdb1",
                            "outline-variant": "#d4c3be",
                            "on-tertiary-container": "#a0bab7",
                            "on-background": "#1b1c1c",
                            "secondary-fixed": "#e4e4cc",
                            "on-error-container": "#93000a",
                            "tertiary-fixed": "#cde8e5",
                            "tertiary": "#1c3433",
                            "secondary-fixed-dim": "#c8c8b0",
                            "on-secondary-fixed": "#1b1d0e",
                            "on-primary": "#ffffff",
                            "surface-container-highest": "#e5e2e1",
                            "on-error": "#ffffff",
                            "outline": "#827470",
                            "on-tertiary": "#ffffff",
                            "primary-container": "#5d4037",
                            "surface-bright": "#fcf9f8",
                            "on-primary-fixed": "#2c160e",
                            "error": "#ba1a1a"
                        },
                        "borderRadius": {
                            "DEFAULT": "0.25rem",
                            "lg": "0.5rem",
                            "xl": "0.75rem",
                            "full": "9999px"
                        },
                        "spacing": {
                            "xl": "64px",
                            "margin": "32px",
                            "sm": "12px",
                            "xs": "4px",
                            "md": "24px",
                            "gutter": "24px",
                            "lg": "40px",
                            "base": "8px"
                        },
                        "fontFamily": {
                            "headline-xl": ["Manrope"],
                            "label-md": ["Hanken Grotesk"],
                            "body-sm": ["Hanken Grotesk"],
                            "headline-lg": ["Manrope"],
                            "body-md": ["Hanken Grotesk"],
                            "headline-md": ["Manrope"],
                            "headline-lg-mobile": ["Manrope"],
                            "body-lg": ["Hanken Grotesk"]
                        },
                        "fontSize": {
                            "headline-xl": ["40px", { "lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                            "label-md": ["14px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600" }],
                            "body-sm": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                            "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                            "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                            "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                            "headline-lg-mobile": ["28px", { "lineHeight": "36px", "fontWeight": "600" }],
                            "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }]
                        }
                    }
                }
            }
    </script>
    <style>
            body {
                font-family: 'Hanken Grotesk', sans-serif;
                background-color: #fcf9f8;
                color: #1b1c1c;
            }

            .material-symbols-outlined {
                font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            }

            .wood-pattern {
                background-image: radial-gradient(#d4c3be 0.5px, transparent 0.5px);
                background-size: 16px 16px;
            }

            .form-shadow {
                box-shadow: 0 4px 20px -2px rgba(68, 42, 34, 0.08);
            }

            .switch-checkbox:checked + .switch-label {
                background-color: #442a22;
            }

                .switch-checkbox:checked + .switch-label::after {
                    transform: translateX(1.5rem);
                }
    </style>
    <style>
            body {
                min-height: max(884px, 100dvh);
            }
    </style>
</head>
<body class="min-h-screen">
    <!-- TopAppBar -->
    <header class="fixed top-0 left-0 right-0 h-16 bg-surface border-b border-outline-variant flex items-center px-4 md:px-margin z-50">
        <div class="flex items-center w-full max-w-7xl mx-auto">
            <button class="p-2 hover:bg-surface-variant/50 rounded-full transition-all active:scale-95" title="Regresar">
                <span class="material-symbols-outlined text-primary">arrow_back</span>
            </button>
            <div class="flex-1 flex justify-center items-baseline gap-2">
                <span class="text-headline-md font-headline-md font-bold tracking-tight text-primary">Carpintec</span>
                <span class="hidden md:inline text-on-surface-variant font-label-md">| Registro de Producto</span>
            </div>
            <div class="w-10"></div> <!-- Spacer for symmetry -->
        </div>
    </header>
    <main class="pt-24 pb-16 px-4 md:px-margin max-w-7xl mx-auto">
        <div class="mb-lg">
            <h1 class="font-headline-lg text-headline-lg text-primary">Registrar Nuevo Producto</h1>
            <p class="font-body-md text-on-surface-variant mt-1">Complete los detalles técnicos y visuales para el inventario de la carpintería.</p>
        </div>
        <form class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
            <!-- Left Column: Visuals -->
            <div class="lg:col-span-5 flex flex-col gap-md">
                <div class="bg-white p-md rounded-xl border border-outline-variant form-shadow">
                    <label class="block font-label-md text-on-surface-variant mb-md uppercase tracking-wider">Fotografía del Producto</label>
                    <div class="relative aspect-square w-full rounded-lg border-2 border-dashed border-outline-variant bg-surface-container-low flex flex-col items-center justify-center gap-base cursor-pointer hover:bg-surface-variant/20 transition-colors group">
                        <input class="absolute inset-0 opacity-0 cursor-pointer" id="product-image" type="file">
                        <span class="material-symbols-outlined text-primary text-5xl opacity-40 group-hover:scale-110 transition-transform">add_a_photo</span>
                        <div class="text-center">
                            <p class="font-label-md text-primary">Subir imagen</p>
                            <p class="text-[12px] text-on-surface-variant mt-1">PNG, JPG hasta 5MB</p>
                        </div>
                    </div>
                    <div class="mt-md grid grid-cols-4 gap-sm">
                        <!-- Thumbnail Placeholders -->
                        <div class="aspect-square rounded-lg bg-surface-container-high flex items-center justify-center">
                            <span class="material-symbols-outlined text-on-surface-variant opacity-30">image</span>
                        </div>
                        <div class="aspect-square rounded-lg bg-surface-container-high flex items-center justify-center border-2 border-dashed border-outline-variant">
                            <span class="material-symbols-outlined text-on-surface-variant opacity-30">add</span>
                        </div>
                    </div>
                </div>
                <!-- Info Box -->
                <div class="bg-secondary-container/30 p-md rounded-xl border border-outline-variant flex gap-md">
                    <span class="material-symbols-outlined text-secondary">info</span>
                    <p class="font-body-sm text-on-secondary-container italic">
                        "Un acabado fotográfico de alta calidad mejora la percepción de valor en las cotizaciones automáticas para clientes premium."
                    </p>
                </div>
            </div>
            <!-- Right Column: Details -->
            <div class="lg:col-span-7 flex flex-col gap-md">
                <!-- Main Details Card -->
                <div class="bg-white p-md rounded-xl border border-outline-variant form-shadow flex flex-col gap-md">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                        <div class="flex flex-col gap-xs col-span-full">
                            <label class="font-label-md text-on-surface-variant" for="p-name">Nombre del producto</label>
                            <input class="w-full bg-surface-container-lowest border-outline-variant rounded-lg focus:ring-primary focus:border-primary p-3 font-body-md" id="p-name" placeholder="Ej. Mesa de Comedor Escandinava" type="text">
                        </div>
                        <div class="flex flex-col gap-xs">
                            <label class="font-label-md text-on-surface-variant" for="p-cat">Categoría</label>
                            <select class="w-full bg-surface-container-lowest border-outline-variant rounded-lg focus:ring-primary focus:border-primary p-3 font-body-md" id="p-cat">
                                <option>Maderas</option>
                                <option>Herrajes</option>
                                <option>Mobiliario Final</option>
                                <option>Acabados</option>
                                <option>Herramientas</option>
                            </select>
                        </div>
                        <div class="flex flex-col gap-xs">
                            <label class="font-label-md text-on-surface-variant" for="p-wood">Tipo de madera sugerida</label>
                            <input class="w-full bg-surface-container-lowest border-outline-variant rounded-lg focus:ring-primary focus:border-primary p-3 font-body-md" id="p-wood" placeholder="Ej. Roble Americano, Nogal" type="text">
                        </div>
                    </div>
                    <div class="flex flex-col gap-xs">
                        <label class="font-label-md text-on-surface-variant" for="p-desc">Descripción detallada</label>
                        <textarea class="w-full bg-surface-container-lowest border-outline-variant rounded-lg focus:ring-primary focus:border-primary p-3 font-body-md resize-none" id="p-desc" placeholder="Describa las dimensiones, técnica de ensamble y acabados específicos..." rows="4"></textarea>
                    </div>
                </div>
                <!-- Quotation Section Card -->
                <div class="bg-primary-container/10 p-md rounded-xl border border-primary/20 form-shadow">
                    <div class="flex flex-col gap-md">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-sm">
                                <div class="bg-primary-container p-2 rounded-lg">
                                    <span class="material-symbols-outlined text-on-primary-container" style="font-variation-settings: 'FILL' 1">request_quote</span>
                                </div>
                                <div>
                                    <h3 class="font-headline-md text-primary text-[20px]">Configuración de Cotización</h3>
                                    <p class="font-body-sm text-on-surface-variant">Ajustes para el módulo de ventas rápido.</p>
                                </div>
                            </div>
                            <!-- Custom Switch -->
                            <div class="relative inline-block w-12 h-6 transition duration-200 ease-in">
                                <input class="opacity-0 w-0 h-0 switch-checkbox" id="quote-toggle" type="checkbox">
                                <label class="absolute cursor-pointer top-0 left-0 right-0 bottom-0 bg-surface-variant rounded-full transition-all duration-300 before:content-[''] before:absolute before:h-4 before:w-4 before:left-1 before:bottom-1 before:bg-white before:rounded-full before:transition-all before:duration-300 switch-label after:content-[''] after:absolute after:h-4 after:w-4 after:left-1 after:bottom-1 after:bg-white after:rounded-full after:transition-all after:duration-300" for="quote-toggle"></label>
                            </div>
                        </div>
                        <div class="flex flex-col gap-xs mt-2">
                            <div class="flex items-center justify-between mb-1">
                                <label class="font-label-md text-on-surface-variant" for="p-price">Precio base estimado (opcional)</label>
                                <span class="text-[12px] bg-secondary-container text-on-secondary-container px-2 py-0.5 rounded-full font-label-md">Sugerido para Taller</span>
                            </div>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant font-bold">$</span>
                                <input class="w-full bg-surface-container-lowest border-outline-variant rounded-lg focus:ring-primary focus:border-primary pl-8 p-3 font-body-md" id="p-price" placeholder="0.00" type="number">
                            </div>
                        </div>
                        <p class="text-[13px] text-on-surface-variant leading-relaxed">
                            <span class="font-bold text-primary">Nota:</span> Al habilitar la cotización inmediata, este producto aparecerá como opción rápida en el panel de ventas del mostrador con su precio base precargado.
                        </p>
                    </div>
                </div>
                <!-- Action Buttons -->
                <div class="flex items-center justify-end gap-md mt-md">
                    <button class="px-xl py-3 rounded-lg font-headline-md text-[16px] text-on-surface-variant hover:bg-surface-variant/50 transition-all active:scale-95" type="button">
                        Cancelar
                    </button>
                    <button class="bg-[#442a22] text-white px-xl py-3 rounded-lg font-headline-md text-[16px] shadow-lg hover:shadow-xl hover:brightness-110 transition-all active:scale-95 flex items-center gap-sm" type="submit">
                        <span class="material-symbols-outlined text-[20px]">save</span>
                        Guardar Producto
                    </button>
                </div>
            </div>
        </form>
    </main>
    <!-- Contextual Toast Notification (Hidden by default) -->
    <div class="fixed bottom-margin right-margin bg-on-surface text-surface py-md px-lg rounded-xl shadow-2xl flex items-center gap-md transform translate-y-32 opacity-0 transition-all duration-500 z-[100]" id="toast">
        <span class="material-symbols-outlined text-primary-fixed-dim">check_circle</span>
        <span class="font-label-md">¡Producto registrado exitosamente en el inventario!</span>
    </div>
    <script>
            // Micro-interaction for the Switch
            const toggle = document.getElementById('quote-toggle');
            toggle.addEventListener('change', function() {
                const label = this.nextElementSibling;
                if (this.checked) {
                    label.classList.add('bg-primary');
                } else {
                    label.classList.remove('bg-primary');
                }
            });

            // Simple form submission feedback
            const form = document.querySelector('form');
            form.addEventListener('submit', (e) => {
                e.preventDefault();
                const toast = document.getElementById('toast');
                toast.classList.remove('translate-y-32', 'opacity-0');
                toast.classList.add('translate-y-0', 'opacity-100');

                setTimeout(() => {
                    toast.classList.add('translate-y-32', 'opacity-0');
                    toast.classList.remove('translate-y-0', 'opacity-100');
                }, 3000);
            });

            // Image upload preview simulation
            const imgInput = document.getElementById('product-image');
            imgInput.addEventListener('change', function(e) {
                if (e.target.files && e.target.files[0]) {
                    const reader = new FileReader();
                    reader.onload = function(event) {
                        const parent = imgInput.parentElement;
                        parent.innerHTML = `<img src="${event.target.result}" class="w-full h-full object-cover rounded-lg" data-alt="Product preview thumbnail showing woodworking detail">`;
                    };
                    reader.readAsDataURL(e.target.files[0]);
                }
            });
    </script>
</body></html>