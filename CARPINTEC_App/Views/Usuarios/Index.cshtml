@model IEnumerable<CARPINTEC_App.Models.Usuario>
@{
    ViewData["Title"] = "Usuarios";
}
<!DOCTYPE html>
<html lang="es" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CARPINTEC.COM - Gestión de Usuarios</title>

    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Hanken+Grotesk:wght@400;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block" rel="stylesheet">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
            try {
                tailwind.config = {
                    darkMode: "class",
                    theme: {
                        extend: {
                            "colors": {
                                "on-tertiary-fixed-variant": "#334b49",
                                "tertiary-fixed-dim": "#b1ccc9",
                                "on-primary-fixed-variant": "#5d4037",
                                "on-background": "#1b1c1c",
                                "secondary-fixed": "#e4e4cc",
                                "surface-bright": "#fcf9f8",
                                "on-tertiary-container": "#a0bab7",
                                "inverse-primary": "#e7bdb1",
                                "on-secondary-container": "#636451",
                                "on-error": "#ffffff",
                                "primary-fixed": "#ffdbd0",
                                "on-error-container": "#93000a",
                                "surface-container-lowest": "#ffffff",
                                "background": "#fcf9f8",
                                "surface-container-high": "#eae7e7",
                                "on-surface-variant": "#504441",
                                "on-primary": "#ffffff",
                                "error-container": "#ffdad6",
                                "outline-variant": "#d4c3be",
                                "on-secondary-fixed-variant": "#474836",
                                "surface": "#fcf9f8",
                                "primary-fixed-dim": "#e7bdb1",
                                "surface-container": "#f0eded",
                                "surface-tint": "#77574d",
                                "on-secondary-fixed": "#1b1d0e",
                                "on-primary-container": "#d4ada1",
                                "tertiary-container": "#334b49",
                                "tertiary-fixed": "#cde8e5",
                                "tertiary": "#1c3433",
                                "secondary-fixed-dim": "#c8c8b0",
                                "surface-container-low": "#f6f3f2",
                                "secondary-container": "#e1e1c9",
                                "inverse-surface": "#303030",
                                "on-primary-fixed": "#2c160e",
                                "error": "#ba1a1a",
                                "surface-dim": "#dcd9d9",
                                "on-secondary": "#ffffff",
                                "surface-container-highest": "#e5e2e1",
                                "on-surface": "#1b1c1c",
                                "secondary": "#5e604d",
                                "outline": "#827470",
                                "on-tertiary": "#ffffff",
                                "primary": "#442a22",
                                "on-tertiary-fixed": "#061f1e",
                                "inverse-on-surface": "#f3f0ef"
                            },
                            "borderRadius": {
                                "DEFAULT": "0.25rem",
                                "lg": "0.5rem",
                                "xl": "0.75rem",
                                "full": "9999px"
                            },
                            "spacing": {
                                "sm": "12px",
                                "base": "8px",
                                "xl": "64px",
                                "xs": "4px",
                                "md": "24px",
                                "lg": "40px",
                                "margin": "32px",
                                "gutter": "24px"
                            },
                            "fontFamily": {
                                "headline-xl": ["Manrope"],
                                "headline-lg": ["Manrope"],
                                "headline-md": ["Manrope"],
                                "label-md": ["Hanken Grotesk"],
                                "body-md": ["Hanken Grotesk"],
                                "body-sm": ["Hanken Grotesk"],
                                "body-lg": ["Hanken Grotesk"]
                            }
                        },
                    },
                }
            } catch (_e) { }
    </script>
</head>
<body class="font-body-md text-on-surface bg-background">

    <!-- Top App Bar -->
    <button onclick="history.back()"
            class="flex items-center gap-2 text-primary hover:underline mb-4">
        <span class="material-symbols-outlined">arrow_back</span>
        Volver
    </button>

    <!-- Main Content Canvas -->
    <main class="pt-4 min-h-screen bg-background">
        <div class="p-margin max-w-7xl mx-auto">

            <!-- Header Section -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-md mb-lg">
                <div>
                    <h3 class="font-headline-xl text-headline-xl text-primary mb-xs">Gestión de Usuarios</h3>
                    <p class="font-body-md text-on-surface-variant">Administra los accesos y roles del equipo de Carpintec</p>
                </div>
                <a asp-controller="Usuarios"
                   asp-action="NuevoUsuario"
                   class="px-lg py-sm rounded-xl font-label-md flex items-center gap-2 shadow-md hover:opacity-90 transition-all active:scale-95"
                   style="background-color: rgb(210, 180, 140); color: black; text-decoration:none;">
                    <span class="material-symbols-outlined">person_add</span>
                    Crear Usuario
                </a>
            </div>

            <!-- Stats Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter mb-lg">
                <div class="bg-surface-container-lowest p-md rounded-[24px] shadow-sm flex items-center gap-4 border border-outline-variant/10">
                    <div class="w-12 h-12 rounded-full bg-secondary-container flex items-center justify-center">
                        <span class="material-symbols-outlined text-on-secondary-container">group</span>
                    </div>
                    <div>
                        <p class="text-on-surface-variant text-sm font-label-md">Total Usuarios</p>
                        <p class="text-headline-md font-bold text-primary">48</p>
                    </div>
                </div>
                <div class="bg-surface-container-lowest p-md rounded-[24px] shadow-sm flex items-center gap-4 border border-outline-variant/10">
                    <div class="w-12 h-12 rounded-full bg-tertiary-container flex items-center justify-center">
                        <span class="material-symbols-outlined text-tertiary-fixed">how_to_reg</span>
                    </div>
                    <div>
                        <p class="text-on-surface-variant text-sm font-label-md">Usuarios Activos</p>
                        <p class="text-headline-md font-bold text-primary">42</p>
                    </div>
                </div>
                <div class="bg-surface-container-lowest p-md rounded-[24px] shadow-sm flex items-center gap-4 border border-outline-variant/10">
                    <div class="w-12 h-12 rounded-full bg-primary-fixed flex items-center justify-center">
                        <span class="material-symbols-outlined text-on-primary-fixed">admin_panel_settings</span>
                    </div>
                    <div>
                        <p class="text-on-surface-variant text-sm font-label-md">Administradores</p>
                        <p class="text-headline-md font-bold text-primary">5</p>
                    </div>
                </div>
                <div class="bg-surface-container-lowest p-md rounded-[24px] shadow-sm flex items-center gap-4 border border-outline-variant/10">
                    <div class="w-12 h-12 rounded-full bg-surface-variant flex items-center justify-center">
                        <span class="material-symbols-outlined text-on-surface-variant">person_off</span>
                    </div>
                    <div>
                        <p class="text-on-surface-variant text-sm font-label-md">Inactivos</p>
                        <p class="text-headline-md font-bold text-primary">6</p>
                    </div>
                </div>
            </div>

            <!-- Filters & Search -->
            <div class="bg-white p-md rounded-[24px] shadow-sm mb-md flex flex-wrap items-center gap-md border border-outline-variant/10">
                <div class="flex-1 relative min-w-[300px]">
                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">search</span>
                    <input class="w-full pl-12 pr-4 py-3 bg-surface rounded-xl border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary transition-all font-body-sm" placeholder="Buscar por nombre, correo o rol..." type="text">
                </div>
                <div class="flex items-center gap-sm">
                    <select class="bg-surface border-outline-variant rounded-xl px-4 py-3 font-body-sm focus:border-primary focus:ring-1 focus:ring-primary">
                        <option>Todos los Roles</option>
                        <option>Administrador</option>
                        <option>Asesor Comercial</option>
                        <option>Jefe de Producción</option>
                    </select>
                    <button class="p-3 bg-surface border border-outline-variant rounded-xl hover:bg-surface-container transition-colors" title="Filtrar">
                        <span class="material-symbols-outlined text-primary">filter_list</span>
                    </button>
                </div>
            </div>

            <!-- User List Table -->
            <div class="bg-white rounded-[24px] shadow-sm overflow-hidden border border-outline-variant/10">
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-surface-container text-on-surface-variant border-b border-outline-variant/30">
                            <tr>
                                <th class="px-md py-4 font-label-md">Usuario</th>
                                <th class="px-md py-4 font-label-md">Correo Electrónico</th>
                                <th class="px-md py-4 font-label-md">Rol</th>
                                <th class="px-md py-4 font-label-md text-center">Estado</th>
                                <th class="px-md py-4 font-label-md text-right">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant/20">

                            @foreach (var item in Model)
                            {
                                <tr class="hover:bg-surface-container-low transition-colors">

                                    <td class="px-md py-4">
                                        @item.Nombre @item.Apellido
                                    </td>

                                    <td class="px-md py-4">
                                        @item.Correo
                                    </td>

                                    <td class="px-md py-4">
                                        @item.Rol
                                    </td>

                                    <td class="px-md py-4 text-center">
                                        @item.Estado
                                    </td>

                                    <td class="px-md py-4">
                                        <div class="flex items-center justify-end gap-2">

                                            <a asp-action="Details"
                                               asp-route-id="@item.IdUsuario">
                                                <span class="material-symbols-outlined">
                                                    visibility
                                                </span>
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.IdUsuario">
                                                <span class="material-symbols-outlined">
                                                    edit
                                                </span>
                                            </a>

                                            <form asp-action="CambiarEstado"
                                                  asp-route-id="@item.IdUsuario"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit">

                                                    <span class="material-symbols-outlined">

                                                        @(item.Estado == "Activo"
                                                            ? "person_off"
                                                            : "person")

                                                    </span>

                                                </button>

                                            </form>

                                        </div>
                                    </td>

                                </tr>
                            }

                        </tbody>
                    </table>
                </div>

                <!-- Footer / Pagination -->
                <div class="px-md py-4 bg-surface-container-low border-t border-outline-variant/20 flex flex-col sm:flex-row items-center justify-between gap-4">
                    <p class="text-sm text-on-surface-variant">Mostrando <span class="font-bold text-primary">1 - 4</span> de <span class="font-bold text-primary">48</span> usuarios</p>
                    <div class="flex items-center gap-1">
                        <button class="p-2 text-outline hover:bg-surface-container rounded-lg transition-colors disabled:opacity-50" disabled>
                            <span class="material-symbols-outlined text-[20px]">chevron_left</span>
                        </button>
                        <button class="px-3 py-1 bg-primary text-on-primary rounded-lg text-sm font-bold" style="background-color: rgb(210, 180, 140);">1</button>
                        <button class="px-3 py-1 hover:bg-surface-container text-on-surface rounded-lg text-sm font-bold transition-colors">2</button>
                        <button class="px-3 py-1 hover:bg-surface-container text-on-surface rounded-lg text-sm font-bold transition-colors">3</button>
                        <span class="px-2 text-on-surface-variant">...</span>
                        <button class="px-3 py-1 hover:bg-surface-container text-on-surface rounded-lg text-sm font-bold transition-colors">12</button>
                        <button class="p-2 text-outline hover:bg-surface-container rounded-lg transition-colors">
                            <span class="material-symbols-outlined text-[20px]">chevron_right</span>
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </main>

</body>
</html>