@{
    Layout = null;
}
<!DOCTYPE html>
<html class="light" lang="es" style="">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Carpintec - Nuevo Usuario</title>
    <!-- Google Fonts: Manrope for headlines, Hanken Grotesk for body -->
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&amp;family=Hanken+Grotesk:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
    <!-- Material Symbols Outlined -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <style>
            .material-symbols-outlined {
                font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
                display: inline-block;
                line-height: 1;
                text-transform: none;
                letter-spacing: normal;
                word-wrap: normal;
                white-space: nowrap;
                direction: ltr;
            }

            /* Custom scrollbar for a premium feel */
            ::-webkit-scrollbar {
                width: 6px;
            }

            ::-webkit-scrollbar-track {
                background: #fcf9f8;
            }

            ::-webkit-scrollbar-thumb {
                background: #d4c3be;
                border-radius: 10px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: #827470;
                }

            /* Glassmorphism utility */
            .glass-card {
                background: rgba(255, 255, 255, 0.8);
                backdrop-filter: blur(12px);
                border: 1px solid rgba(212, 195, 190, 0.3);
            }
    </style>
    <script id="tailwind-config">
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        "colors": {
                            "surface-variant": "#e5e2e1",
                            "secondary-fixed": "#e4e4cc",
                            "on-background": "#1b1c1c",
                            "on-tertiary-fixed": "#061f1e",
                            "on-secondary-fixed-variant": "#474836",
                            "on-secondary": "#ffffff",
                            "outline": "#827470",
                            "surface-dim": "#dcd9d9",
                            "on-secondary-container": "#636451",
                            "tertiary": "#1c3433",
                            "surface": "#fcf9f8",
                            "secondary-fixed-dim": "#c8c8b0",
                            "surface-container-lowest": "#ffffff",
                            "primary-fixed": "#ffdbd0",
                            "on-tertiary": "#ffffff",
                            "primary": "#442a22",
                            "on-secondary-fixed": "#1b1d0e",
                            "on-error": "#ffffff",
                            "surface-container-high": "#eae7e7",
                            "tertiary-container": "#334b49",
                            "tertiary-fixed-dim": "#b1ccc9",
                            "secondary-container": "#e1e1c9",
                            "surface-container-highest": "#e5e2e1",
                            "on-surface": "#1b1c1c",
                            "primary-container": "#5d4037",
                            "inverse-surface": "#303030",
                            "primary-fixed-dim": "#e7bdb1",
                            "error-container": "#ffdad6",
                            "error": "#ba1a1a",
                            "on-primary-container": "#d4ada1",
                            "secondary": "#5e604d",
                            "on-tertiary-container": "#a0bab7",
                            "on-primary": "#ffffff",
                            "surface-bright": "#fcf9f8",
                            "tertiary-fixed": "#cde8e5",
                            "outline-variant": "#d4c3be",
                            "on-surface-variant": "#504441",
                            "on-error-container": "#93000a",
                            "on-primary-fixed": "#2c160e",
                            "background": "#fcf9f8",
                            "surface-tint": "#77574d",
                            "surface-container-low": "#f6f3f2",
                            "inverse-primary": "#e7bdb1",
                            "inverse-on-surface": "#f3f0ef",
                            "surface-container": "#f0eded",
                            "on-tertiary-fixed-variant": "#334b49",
                            "on-primary-fixed-variant": "#5d4037",
                            "arena": "#D2B48C"
                        },
                        "borderRadius": {
                            "DEFAULT": "0.25rem",
                            "lg": "0.5rem",
                            "xl": "0.75rem",
                            "full": "9999px"
                        },
                        "spacing": {
                            "lg": "40px",
                            "xl": "64px",
                            "sm": "12px",
                            "md": "24px",
                            "margin": "32px",
                            "base": "8px",
                            "xs": "4px",
                            "gutter": "24px"
                        },
                        "fontFamily": {
                            "body-md": ["Hanken Grotesk"],
                            "body-sm": ["Hanken Grotesk"],
                            "headline-md": ["Manrope"],
                            "headline-lg-mobile": ["Manrope"],
                            "body-lg": ["Hanken Grotesk"],
                            "label-md": ["Hanken Grotesk"],
                            "headline-lg": ["Manrope"],
                            "headline-xl": ["Manrope"]
                        },
                        "fontSize": {
                            "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                            "body-sm": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                            "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                            "headline-lg-mobile": ["28px", { "lineHeight": "36px", "fontWeight": "600" }],
                            "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }],
                            "label-md": ["14px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600" }],
                            "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                            "headline-xl": ["40px", { "lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "700" }]
                        }
                    },
                },
            }
    </script>
</head>
<body class="bg-background text-on-background font-body-md min-h-screen flex">
    <!-- Sidebar Navigation (Desktop) -->
    <!-- Main Content Area -->
    <main class="flex-1 lg:ml-64 pb-24 lg:pb-0 min-h-screen">
        <!-- TopAppBar -->
        <header class="fixed top-0 right-0 left-0 lg:left-64 z-50 bg-surface shadow-sm h-16 flex justify-between items-center px-margin">
            <div class="flex items-center gap-4">
                <button class="w-10 h-10 rounded-full hover:bg-secondary-container/50 flex items-center justify-center transition-colors active:scale-95">
                    <span class="material-symbols-outlined text-primary" data-icon="arrow_back">arrow_back</span>
                </button>
                <h1 class="font-headline-md text-headline-md text-primary tracking-tight">Nuevo Usuario</h1>
            </div>
            <div class="flex items-center gap-4">
                <button class="w-10 h-10 rounded-full hover:bg-secondary-container/50 flex items-center justify-center transition-colors">
                    <span class="material-symbols-outlined text-primary" data-icon="notifications">notifications</span>
                </button>
                <div class="w-8 h-8 rounded-full bg-outline-variant overflow-hidden">
                    <img class="w-full h-full object-cover" data-alt="A professional studio portrait of a corporate administrator in a modern office setting. The lighting is soft and natural, emphasizing the professional and clean aesthetic of the high-end carpentry software brand. The background shows blurred architectural blueprints and warm wood textures." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBqnWtSHg99wIp3LXDj1bLTnLcQxMfk7RiHK5AGtIr6C-42a74RrlEyXCH3wVLtHhy7UWsRmAJ4zzXu4icT9GRBTofLDpkcSHwYocFxXqc4u1S9rUCmCqtLEv41BOD_guGMlfv_d3dAjIiPY4iICkc6fDbjcoNLPd26iTL_3Q6v0YplL_0vLhtzJ5HrBMzMjY8lHu7VQmoliNbMkJoEo8ipJqZSxhmA-weY5rcxCO-rOXAudl0jt2ci">
                </div>
            </div>
        </header>
        <!-- Form Content -->
        <div class="mt-16 p-6 lg:p-margin max-w-5xl mx-auto">
            <div class="mb-lg">
                <p class="text-on-surface-variant font-body-md max-w-2xl">Complete la información a continuación para registrar un nuevo integrante al equipo de Carpintec. Asegúrese de asignar el rol correcto y configurar su horario laboral inicial.</p>
            </div>
            <!-- Bento Layout Form Sections -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
                <!-- Section: Personal Data -->
                <section class="md:col-span-8 bg-white rounded-xl shadow-sm border border-outline-variant/20 p-md flex flex-col gap-md">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="material-symbols-outlined text-primary" data-icon="badge">badge</span>
                        <h2 class="font-headline-md text-headline-md text-primary">Datos Personales</h2>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
                        <div class="flex flex-col gap-1">
                            <label class="text-label-md font-label-md text-on-surface-variant">Nombre Completo</label>
                            <input class="w-full px-4 py-2 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-1 focus:ring-primary focus:border-primary outline-none transition-all" placeholder="Ej: Juan Pérez" type="text">
                        </div>
                        <div class="flex flex-col gap-1">
                            <label class="text-label-md font-label-md text-on-surface-variant">Correo Electrónico</label>
                            <input class="w-full px-4 py-2 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-1 focus:ring-primary focus:border-primary outline-none transition-all" placeholder="juan.perez@carpintec.com" type="email">
                        </div>
                        <div class="flex flex-col gap-1">
                            <label class="text-label-md font-label-md text-on-surface-variant">Teléfono de Contacto</label>
                            <input class="w-full px-4 py-2 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-1 focus:ring-primary focus:border-primary outline-none transition-all" placeholder="+57 300 000 0000" type="tel">
                        </div>
                        <div class="flex flex-col gap-1">
                            <label class="text-label-md font-label-md text-on-surface-variant">ID de Documento (C.C / NIT)</label>
                            <input class="w-full px-4 py-2 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-1 focus:ring-primary focus:border-primary outline-none transition-all" placeholder="1.000.000.000" type="text">
                        </div>
                    </div>
                    <div class="mt-4 p-4 bg-secondary-container/20 rounded-lg flex gap-4 items-start border border-secondary-container">
                        <span class="material-symbols-outlined text-secondary" data-icon="info">info</span>
                        <p class="text-body-sm text-secondary-fixed-dim bg-secondary p-1 rounded px-2 inline-block font-semibold">Nota</p>
                        <p class="text-body-sm text-on-surface-variant italic">El correo electrónico se utilizará como credencial de acceso para el portal administrativo.</p>
                    </div>
                </section>
                <!-- Section: Role Assignment -->
                <section class="md:col-span-4 bg-white rounded-xl shadow-sm border border-outline-variant/20 p-md flex flex-col gap-md">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="material-symbols-outlined text-primary" data-icon="manage_accounts">manage_accounts</span>
                        <h2 class="font-headline-md text-headline-md text-primary">Asignar Rol</h2>
                    </div>
                    <div class="flex flex-col gap-3">
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-sm" data-icon="search">search</span>
                            <input class="w-full pl-10 pr-4 py-2 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-1 focus:ring-primary focus:border-primary outline-none text-body-sm" placeholder="Buscar rol..." type="text">
                        </div>
                        <div class="space-y-2 h-[220px] overflow-y-auto pr-1">
                            <label class="flex items-center gap-3 p-2 hover:bg-surface-container-low rounded-lg cursor-pointer transition-colors border border-transparent hover:border-outline-variant/20 group">
                                <input class="w-4 h-4 text-primary focus:ring-primary" name="role" type="radio">
                                <span class="text-body-md text-on-surface-variant group-hover:text-primary transition-colors">Administrador</span>
                            </label>
                            <label class="flex items-center gap-3 p-2 hover:bg-surface-container-low rounded-lg cursor-pointer transition-colors border border-transparent hover:border-outline-variant/20 group">
                                <input class="w-4 h-4 text-primary focus:ring-primary" name="role" type="radio">
                                <span class="text-body-md text-on-surface-variant group-hover:text-primary transition-colors">Asesor Comercial</span>
                            </label>
                            <label class="flex items-center gap-3 p-2 hover:bg-surface-container-low rounded-lg cursor-pointer transition-colors border border-transparent hover:border-outline-variant/20 group">
                                <input class="w-4 h-4 text-primary focus:ring-primary" name="role" type="radio">
                                <span class="text-body-md text-on-surface-variant group-hover:text-primary transition-colors">Encargado de Inventario</span>
                            </label>
                            <label class="flex items-center gap-3 p-2 hover:bg-surface-container-low rounded-lg cursor-pointer transition-colors border border-transparent hover:border-outline-variant/20 group">
                                <input class="w-4 h-4 text-primary focus:ring-primary" name="role" type="radio">
                                <span class="text-body-md text-on-surface-variant group-hover:text-primary transition-colors">Jefe de Producción</span>
                            </label>
                            <label class="flex items-center gap-3 p-2 hover:bg-surface-container-low rounded-lg cursor-pointer transition-colors border border-transparent hover:border-outline-variant/20 group">
                                <input class="w-4 h-4 text-primary focus:ring-primary" name="role" type="radio">
                                <span class="text-body-md text-on-surface-variant group-hover:text-primary transition-colors">Operario de Carpintería</span>
                            </label>
                            <label class="flex items-center gap-3 p-2 hover:bg-surface-container-low rounded-lg cursor-pointer transition-colors border border-transparent hover:border-outline-variant/20 group">
                                <input class="w-4 h-4 text-primary focus:ring-primary" name="role" type="radio">
                                <span class="text-body-md text-on-surface-variant group-hover:text-primary transition-colors">Diseñador de Muebles</span>
                            </label>
                        </div>
                    </div>
                </section>
                <!-- Section: Work Schedule -->
                <section class="md:col-span-12 bg-white rounded-xl shadow-sm border border-outline-variant/20 p-md">
                    <div class="flex items-center gap-2 mb-6">
                        <span class="material-symbols-outlined text-primary" data-icon="schedule">schedule</span>
                        <h2 class="font-headline-md text-headline-md text-primary">Horario Laboral</h2>
                    </div>
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-lg">
                        <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-1">
                                <label class="text-label-md font-label-md text-on-surface-variant">Hora de Inicio</label>
                                <input class="w-full px-4 py-2 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-1 focus:ring-primary focus:border-primary outline-none transition-all" type="time" value="08:00">
                            </div>
                            <div class="flex flex-col gap-1">
                                <label class="text-label-md font-label-md text-on-surface-variant">Hora de Fin</label>
                                <input class="w-full px-4 py-2 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-1 focus:ring-primary focus:border-primary outline-none transition-all" type="time" value="18:00">
                            </div>
                        </div>
                        <div class="lg:col-span-2">
                            <label class="text-label-md font-label-md text-on-surface-variant mb-3 block">Días de la Semana</label>
                            <div class="flex flex-wrap gap-2">
                                <label class="cursor-pointer">
                                    <input checked="" class="hidden peer" type="checkbox">
                                    <div class="px-5 py-2 rounded-lg border border-outline-variant bg-surface-container-low text-on-surface-variant peer-checked:bg-primary peer-checked:text-white peer-checked:border-primary transition-all font-semibold">Lunes</div>
                                </label>
                                <label class="cursor-pointer">
                                    <input checked="" class="hidden peer" type="checkbox">
                                    <div class="px-5 py-2 rounded-lg border border-outline-variant bg-surface-container-low text-on-surface-variant peer-checked:bg-primary peer-checked:text-white peer-checked:border-primary transition-all font-semibold">Martes</div>
                                </label>
                                <label class="cursor-pointer">
                                    <input checked="" class="hidden peer" type="checkbox">
                                    <div class="px-5 py-2 rounded-lg border border-outline-variant bg-surface-container-low text-on-surface-variant peer-checked:bg-primary peer-checked:text-white peer-checked:border-primary transition-all font-semibold">Miércoles</div>
                                </label>
                                <label class="cursor-pointer">
                                    <input checked="" class="hidden peer" type="checkbox">
                                    <div class="px-5 py-2 rounded-lg border border-outline-variant bg-surface-container-low text-on-surface-variant peer-checked:bg-primary peer-checked:text-white peer-checked:border-primary transition-all font-semibold">Jueves</div>
                                </label>
                                <label class="cursor-pointer">
                                    <input checked="" class="hidden peer" type="checkbox">
                                    <div class="px-5 py-2 rounded-lg border border-outline-variant bg-surface-container-low text-on-surface-variant peer-checked:bg-primary peer-checked:text-white peer-checked:border-primary transition-all font-semibold">Viernes</div>
                                </label>
                                <label class="cursor-pointer">
                                    <input class="hidden peer" type="checkbox">
                                    <div class="px-5 py-2 rounded-lg border border-outline-variant bg-surface-container-low text-on-surface-variant peer-checked:bg-primary peer-checked:text-white peer-checked:border-primary transition-all font-semibold">Sábado</div>
                                </label>
                                <label class="cursor-pointer">
                                    <input class="hidden peer" type="checkbox">
                                    <div class="px-5 py-2 rounded-lg border border-outline-variant bg-surface-container-low text-on-surface-variant peer-checked:bg-primary peer-checked:text-white peer-checked:border-primary transition-all font-semibold">Domingo</div>
                                </label>
                            </div>
                            <p class="text-xs text-on-surface-variant mt-4 flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm" data-icon="history_toggle_off">history_toggle_off</span>
                                El sistema ajustará automáticamente los permisos de acceso basados en este horario.
                            </p>
                        </div>
                    </div>
                </section>
            </div>
            <!-- Action Buttons -->
            <div class="mt-lg flex flex-col sm:flex-row items-center justify-end gap-md border-t border-outline-variant/30 pt-md">
                <button class="w-full sm:w-auto px-xl py-3 rounded-xl border border-outline text-primary font-bold hover:bg-surface-container-high transition-colors active:scale-95">
                    Cancelar
                </button>
                <button class="w-full sm:w-auto px-xl py-3 rounded-xl bg-primary text-white font-bold shadow-md hover:bg-primary-container transition-all active:scale-95 flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-[20px]" data-icon="save">save</span>
                    Guardar Usuario
                </button>
            </div>
        </div>
    </main>
    <!-- Bottom Navigation (Mobile Only) -->
    <nav class="lg:hidden fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-4 pb-safe h-20 bg-surface rounded-t-xl shadow-lg border-t border-outline-variant/20">
        <button class="flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors">
            <span class="material-symbols-outlined" data-icon="home">home</span>
            <span class="font-label-md text-label-md">Home</span>
        </button>
        <button class="flex flex-col items-center justify-center bg-primary-container text-on-primary-container rounded-full px-4 py-1 active:scale-90 duration-150">
            <span class="material-symbols-outlined" data-icon="groups">groups</span>
            <span class="font-label-md text-label-md">Clients</span>
        </button>
        <button class="flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors">
            <span class="material-symbols-outlined" data-icon="description">description</span>
            <span class="font-label-md text-label-md">Quotes</span>
        </button>
        <button class="flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors">
            <span class="material-symbols-outlined" data-icon="inventory">inventory</span>
            <span class="font-label-md text-label-md">Stock</span>
        </button>
        <button class="flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors">
            <span class="material-symbols-outlined" data-icon="package_2">package_2</span>
            <span class="font-label-md text-label-md">Orders</span>
        </button>
    </nav>
    <!-- Visual Polish: Background Texture -->
    <div class="fixed inset-0 pointer-events-none opacity-[0.03] z-[-1]" style="background-image: url(&quot;https://www.transparenttextures.com/patterns/wood-pattern.png&quot;);"></div>
    <script>
            // Micro-interactions for form inputs
            document.querySelectorAll('input').forEach(input => {
                input.addEventListener('focus', () => {
                    input.parentElement.querySelector('label')?.classList.add('text-primary');
                });
                input.addEventListener('blur', () => {
                    input.parentElement.querySelector('label')?.classList.remove('text-primary');
                });
            });

            // Simple validation visualization
            const saveBtn = document.querySelector('button.bg-primary');
            saveBtn.addEventListener('click', () => {
                saveBtn.innerHTML = '<span class="material-symbols-outlined animate-spin" data-icon="progress_activity">progress_activity</span> Guardando...';
                setTimeout(() => {
                    saveBtn.innerHTML = '<span class="material-symbols-outlined" data-icon="check_circle">check_circle</span> Usuario Guardado';
                    saveBtn.classList.replace('bg-primary', 'bg-green-600');
                    setTimeout(() => {
                        saveBtn.innerHTML = '<span class="material-symbols-outlined" data-icon="save">save</span> Guardar Usuario';
                        saveBtn.classList.replace('bg-green-600', 'bg-primary');
                    }, 2000);
                }, 1500);
            });
    </script>



</body></html>