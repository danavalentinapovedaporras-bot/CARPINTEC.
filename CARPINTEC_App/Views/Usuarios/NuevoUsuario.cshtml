@model CARPINTEC_App.Models.Usuario

@{
    ViewData["Title"] = "Crear Usuario";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CARPINTEC.COM - Crear Usuario</title>

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Hanken+Grotesk:wght@400;600&display=swap"
          rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
          rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#fcf9f8] text-[#1b1c1c]">

    <main class="min-h-screen p-8">

        <div class="max-w-3xl mx-auto">

            <!-- Volver -->
            <a asp-controller="Usuarios"
               asp-action="Index"
               class="flex items-center gap-2 text-[#442a22] hover:underline mb-6">

                <span class="material-symbols-outlined">
                    arrow_back
                </span>

                Volver a Gestión de Usuarios
            </a>


            <!-- Encabezado -->
            <div class="mb-8">

                <h1 class="text-3xl font-bold text-[#442a22]">
                    Crear Usuario
                </h1>

                <p class="text-gray-600 mt-2">
                    Registra un nuevo usuario y asigna el rol correspondiente.
                </p>

            </div>


            <!-- Formulario -->
            <form asp-controller="Usuarios"
                  asp-action="NuevoUsuario"
                  method="post"
                  class="bg-white rounded-3xl shadow-sm border border-gray-200 p-8">

                @Html.AntiForgeryToken()


                <!-- Errores -->
                <div asp-validation-summary="ModelOnly"
                     class="text-red-600 mb-6">
                </div>


                <!-- Nombre y Apellido -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                    <!-- Nombre -->
                    <div>

                        <label asp-for="Nombre"
                               class="block font-semibold mb-2">
                            Nombre
                        </label>

                        <input asp-for="Nombre"
                               class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:border-[#442a22] focus:ring-[#442a22]"
                               placeholder="Ingrese el nombre" />

                        <span asp-validation-for="Nombre"
                              class="text-red-600 text-sm">
                        </span>

                    </div>


                    <!-- Apellido -->
                    <div>

                        <label asp-for="Apellido"
                               class="block font-semibold mb-2">
                            Apellido
                        </label>

                        <input asp-for="Apellido"
                               class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:border-[#442a22] focus:ring-[#442a22]"
                               placeholder="Ingrese el apellido" />

                        <span asp-validation-for="Apellido"
                              class="text-red-600 text-sm">
                        </span>

                    </div>

                </div>


                <!-- Correo -->
                <div class="mt-6">

                    <label asp-for="Correo"
                           class="block font-semibold mb-2">
                        Correo electrónico
                    </label>

                    <input asp-for="Correo"
                           type="email"
                           class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:border-[#442a22] focus:ring-[#442a22]"
                           placeholder="ejemplo@correo.com" />

                    <span asp-validation-for="Correo"
                          class="text-red-600 text-sm">
                    </span>

                </div>


                <!-- Contraseña -->
                <div class="mt-6">

                    <label asp-for="Contraseña"
                           class="block font-semibold mb-2">
                        Contraseña
                    </label>

                    <div class="relative">

                        <input asp-for="Contraseña"
                               id="password"
                               type="password"
                               class="w-full rounded-xl border border-gray-300 px-4 py-3 pr-12 focus:border-[#442a22] focus:ring-[#442a22]"
                               placeholder="Ingrese una contraseña" />

                        <!-- Botón mostrar contraseña -->
                        <button type="button"
                                onclick="mostrarContraseña()"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-[#442a22] text-xl"
                                title="Mostrar contraseña">

                            <span id="iconoPassword">
                                🙈
                            </span>

                        </button>

                    </div>

                    <span asp-validation-for="Contraseña"
                          class="text-red-600 text-sm">
                    </span>

                </div>


                <!-- Rol -->
                <div class="mt-6">

                    <label asp-for="Rol"
                           class="block font-semibold mb-2">
                        Rol
                    </label>

                    <select asp-for="Rol"
                            class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:border-[#442a22] focus:ring-[#442a22]">

                        <option value="">
                            Seleccione un rol
                        </option>

                        <option value="Asesor Comercial">
                            Asesor Comercial
                        </option>

                        <option value="Diseñador de Muebles">
                            Diseñador de Muebles
                        </option>

                        <option value="Jefe de Producción">
                            Jefe de Producción
                        </option>

                        <option value="Operario de Carpintería">
                            Operario de Carpintería
                        </option>

                        <option value="Encargado de Inventario">
                            Encargado de Inventario
                        </option>

                    </select>

                    <span asp-validation-for="Rol"
                          class="text-red-600 text-sm">
                    </span>

                </div>


                <!-- Estado -->
                <div class="mt-6">

                    <label asp-for="Estado"
                           class="block font-semibold mb-2">
                        Estado
                    </label>

                    <select asp-for="Estado"
                            class="w-full rounded-xl border border-gray-300 px-4 py-3">

                        <option value="Activo">
                            Activo
                        </option>

                        <option value="Inactivo">
                            Inactivo
                        </option>

                    </select>

                </div>


                <!-- Botones -->
                <div class="flex flex-col sm:flex-row justify-end gap-4 mt-8">

                    <!-- Cancelar -->
                    <a asp-controller="Usuarios"
                       asp-action="Index"
                       class="px-6 py-3 rounded-xl border border-gray-300 text-center hover:bg-gray-100">

                        Cancelar

                    </a>


                    <!-- Crear -->
                    <button type="submit"
                            class="px-6 py-3 rounded-xl font-semibold shadow-md hover:opacity-90"
                            style="background-color: rgb(210, 180, 140); color: black;">

                        <span class="material-symbols-outlined align-middle mr-1">
                            person_add
                        </span>

                        Crear Usuario

                    </button>

                </div>

            </form>

        </div>

    </main>


    <!-- Validaciones -->
    <partial name="_ValidationScriptsPartial" />


    <!-- Mostrar / Ocultar contraseña -->
    <script>

            function mostrarContraseña() {

                const password = document.getElementById("password");
                const icono = document.getElementById("iconoPassword");

                if (password.type === "password") {

                    password.type = "text";

                    icono.textContent = "👁️";

                }
                else {

                    password.type = "password";

                    icono.textContent = "🙈";

                }

            }

    </script>

</body>
</html>