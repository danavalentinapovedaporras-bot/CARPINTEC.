            <!-- Mueble de Roble -->
            <div class="lg:col-span-4 group">
                <div class="bg-surface-container-lowest wood-frame rounded-lg overflow-hidden shadow-subtle transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
                    <div class="aspect-[4/5] overflow-hidden">
                        <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" data-alt="A studio photograph of two minimalist bedside tables made of light oak wood. The nightstands feature a clean rectangular frame, one drawer with a carved handle, and an open lower shelf. They are styled with neutral-toned ceramic lamps and books in a bright, modern bedroom setting. The lighting is soft and even, highlighting the fine wood grain and professional joinery." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDhro3XhEU-InQc3Uv8-J0YQGb946kGinO0mfbSAxJ02pz73bCt8l-76Ygu3oPAsY6AmIsZ_5OpXzw0dE1bDd_xAzkJ4mjxKTIeaZ0q3lZ5peykEo-QQYmKK6cESy_-fsfGFMumkWGsC3rnkLuyGKBxgZUrAzMOgQfnp7Jrhtb_Lmm1_7LYXlGofgMhsBvDP81naYJX-U51t5CBBlbYbPM10nDftrYmpxmxhWVMocXumbVfPtOJriC21A">
                    </div>
