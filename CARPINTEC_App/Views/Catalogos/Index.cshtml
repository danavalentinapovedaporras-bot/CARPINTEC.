    <style>
            .material-symbols-outlined {
                font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            }

            body {
                background-color: #fff8f6;
                color: #201a18;
            }

            .bento-grid {
                display: grid;
                grid-template-columns: repeat(12, 1fr);
                gap: 24px;
            }

            .wood-frame {
                border: 3px solid #6c2f00;
            }

            .shadow-subtle {
                box-shadow: 0px 4px 12px rgba(0,0,0,0.05);
            }
    </style>
    <style>
            body {
                min-height: max(884px, 100dvh);
            }
    </style>
</head>
<body class="font-body-md text-body-md overflow-x-hidden">
    <!-- TopAppBar -->
    <header class="bg-primary dark:bg-primary-container text-on-primary dark:text-on-primary-container w-full top-0 sticky border-b-4 border-secondary shadow-sm flex items-center justify-between px-margin-mobile md:px-margin-desktop h-16 w-full z-50">
        <div class="flex items-center gap-3 cursor-pointer active:scale-95">

            <h1 class="font-headline-lg text-headline-lg font-bold text-on-primary tracking-tight">CARPINTEC</h1>
        </div>
        <nav class="hidden md:flex gap-gutter font-title-md text-title-md">
            <a class="text-on-primary/80 hover:bg-secondary-container transition-colors px-4 py-1 rounded" href="#">Inicio</a>
            <a class="text-on-primary font-bold hover:bg-secondary-container transition-colors px-4 py-1 rounded" href="#">Catálogo</a>
            <a class="text-on-primary/80 hover:bg-secondary-container transition-colors px-4 py-1 rounded" href="#">Cotizaciones</a>
        </nav>
        <button class="bg-secondary-container text-on-secondary-container px-6 py-2 rounded-full font-bold hover:bg-secondary transition-all active:scale-95 hidden md:block">Contacto</button>
    </header>
    <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12 md:py-20">
        <section class="mb-20 grid grid-cols-1 md:grid-cols-2 gap-gutter"><div class="group"><div class="bg-surface-container-lowest wood-frame rounded-lg overflow-hidden shadow-subtle transition-all duration-300 hover:shadow-xl hover:-translate-y-1"><div class="aspect-[16/9] overflow-hidden"><img alt="Vestidor de roble de lujo" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" src="https://lh3.googleusercontent.com/aida/AP1WRLsdB06ZHXn-W4--9-q-GAd8-ALFwd4pZnAhGM_lcgIJGX5az6DB3OYSPT7l0M6DRyqUHMuKaWfEFB6tLU1rjLnTQan845qal62bC4He_KmnUt7z1puSuSngbvDJP9Gr2Bx_xE7Jsf_h3JwRw-mUKcEcZX1P7Vy95SZjGhBaDytQelOjn6oEvvY1KIgUESiFKc_SqhqsVfuiI9ljKwmN4WJcBWAdsOucAijNPuLheH6e9pPq4myqUimYhlYElkxLwnyZK1mGWoszudI"></div><div class="p-6 space-y-4"><div class="flex justify-between items-start"><h4 class="font-title-md text-title-md text-primary">Vestidor de Roble</h4><span class="bg-primary text-on-primary px-3 py-1 text-[12px] font-bold rounded">NUEVO</span></div><p class="font-body-md text-body-md text-on-surface-variant">Sistema de almacenamiento integral en roble macizo con iluminación LED integrada y herrajes de alta gama.</p><button class="w-full bg-primary text-on-primary py-3 rounded font-bold hover:bg-secondary transition-colors active:scale-95 flex items-center justify-center gap-2"><span class="material-symbols-outlined">request_quote</span> Cotizar Diseño</button></div></div></div><div class="group"><div class="bg-surface-container-lowest wood-frame rounded-lg overflow-hidden shadow-subtle transition-all duration-300 hover:shadow-xl hover:-translate-y-1"><div class="aspect-[16/9] overflow-hidden"><img alt="Cama de diseño en nogal" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" src="https://lh3.googleusercontent.com/aida/AP1WRLtiAY0Z5tq6mnIDnTD7_dtyC3vcq1skv_UYZC5pBcramZGZqfmZR8I2w8swWupXWKmPwZXBvU5N21y5tMeLQ-O9KVGx22wa6HV9TQZ3R58lIwozRUlIYVrPQCdXdc0Iuw43LRxQ3Ey21WcjniERlcB5GEUK83tXX5rlOxSCYnA50byKDUlqcGyiQK4_8Uw6luVv_bj2Ox8pQMvjARcJXk_9YhSB0Vg9KoGhrcSKGACCdqAE6TodOymyF8D_"></div><div class="p-6 space-y-4"><div class="flex justify-between items-start"><h4 class="font-title-md text-title-md text-primary">Cama Zen Nogal</h4><span class="bg-surface-variant text-on-surface-variant px-2 py-1 text-[10px] font-bold rounded uppercase">Colección Premium</span></div><p class="font-body-md text-body-md text-on-surface-variant">Estructura minimalista de nogal americano con cabecero tapizado en lino natural. Confort y elegancia artesanal.</p><button class="w-full bg-primary text-on-primary py-3 rounded font-bold hover:bg-secondary transition-colors active:scale-95 flex items-center justify-center gap-2"><span class="material-symbols-outlined">request_quote</span> Cotizar</button></div></div></div></section>
        <!-- Hero Section -->
        <!-- Product Catalog Header -->
        <div class="flex flex-col md:flex-row justify-between items-end mb-12 border-b-2 border-outline-variant pb-6">
            <div>
                <h3 class="font-headline-lg text-headline-lg text-primary mb-2">Catálogo de Piezas</h3>
                <p class="font-body-md text-body-md text-on-surface-variant">Artesanía modular y mobiliario de alta gama para espacios exigentes.</p>
            </div>
            <div class="mt-6 md:mt-0 flex gap-4">
                <button class="flex items-center gap-2 font-label-md text-label-md text-primary border border-outline px-4 py-2 rounded active:scale-95">
                    <span class="material-symbols-outlined">filter_list</span> Filtrar
                </button>
                <button class="flex items-center gap-2 font-label-md text-label-md text-primary border border-outline px-4 py-2 rounded active:scale-95">
                    <span class="material-symbols-outlined">sort</span> Ordenar
                </button>
            </div>
        </div>
        <!-- Product Grid -->
