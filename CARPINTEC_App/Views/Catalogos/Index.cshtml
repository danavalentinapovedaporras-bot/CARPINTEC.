                        </div>
                        <button class="w-full bg-primary text-on-primary py-3 rounded font-bold hover:bg-secondary transition-colors active:scale-95 flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined">request_quote</span> Cotizar
                        </button>
