    <script>
            // Simple interactive micro-interactions
            document.querySelectorAll('button').forEach(button => {
                button.addEventListener('mouseenter', () => {
                    if (button.classList.contains('bg-primary')) {
                        button.classList.replace('bg-primary', 'bg-secondary');
                    }
                });
                button.addEventListener('mouseleave', () => {
                    if (button.classList.contains('bg-secondary')) {
                        button.classList.replace('bg-secondary', 'bg-primary');
                    }
                });
            });
    </script>


