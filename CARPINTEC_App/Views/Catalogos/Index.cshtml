                        <button class="mt-8 w-full bg-primary text-on-primary py-4 rounded font-bold hover:bg-secondary transition-colors active:scale-95 flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined">request_quote</span> Cotizar Diseño a Medida
                        </button>
                    </div>
                </div>
            </div>
            <!-- Silla de Cedro -->
            <div class="lg:col-span-5 group">
                <div class="bg-surface-container-lowest wood-frame rounded-lg overflow-hidden shadow-subtle transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
                    <div class="aspect-square overflow-hidden bg-surface-variant flex items-center justify-center">
                        <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" data-alt="A detailed close-up of a handcrafted wooden armchair with a curved back and spindle design. The chair is made from reddish-brown cedar wood and stands in a bright carpentry workshop with sawdust on the floor. Every joint is visible, showcasing expert dovetail and mortise-and-tenon work. The lighting is dramatic, casting soft shadows that highlight the sculptural form of the chair's arms." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBJxUtrXtdDvigw_SF486jgunUDNOvF6ygYICBmL7Nuy21jlUjfZsTjrb1btWUFskNyM6UOh_uSGWLD4sjvWycWId88qeq4aN8ZNksmexqzPLzbOLp3MhZAQ4JJwegZ9Mjhq-N3DfVjW241txOVGkwSMF5KvZilvsjp1PBQR3LSj3q0y9jysK91mxfsv2mHms6XJ6yjxzGmyLLiD89VO529XG2_ALtgwQxpDMVYaE27mm8L7CriMl8xFw">
