                    <div class="flex-grow min-w-0">
                        <div class="flex justify-between items-center mb-1"><h2 class="font-bold text-[16px] text-primary truncate">#FAC-2024-034</h2><span class="text-[12px] text-on-surface-variant">15/10/23</span></div>
                        <div class="flex items-center gap-3"><span class="bg-secondary-container/20 text-secondary-container text-[12px] px-2 py-0.5 rounded-full font-medium border border-secondary-container/30">Pendiente</span><p class="text-[14px] font-bold text-on-surface">$2.8M</p></div>
                    </div>
                </div>
                <div class="flex sm:flex-col justify-between sm:justify-center items-center sm:items-end w-full sm:w-auto gap-3 mt-2 sm:mt-0 pt-2 sm:pt-0 border-t sm:border-t-0 border-outline-variant">
                    <div class="flex gap-2 opacity-60"><span class="material-symbols-outlined text-[18px] text-on-surface-variant">account_balance_wallet</span><span class="material-symbols-outlined text-[18px] text-on-surface-variant">smartphone</span></div>
                    <button class="bg-primary text-on-primary text-[14px] px-5 py-2 rounded-lg font-bold shadow-sm hover:bg-primary/90 transition-colors">Pagar</button>
                </div>
            </article>
            <!-- Invoice Card: Overdue -->
            <article class="bg-surface-container-lowest border border-outline-variant rounded-xl flex flex-col sm:flex-row items-start sm:items-center gap-4 p-4 shadow-sm relative overflow-hidden">
                <div class="absolute top-0 left-0 w-1.5 h-full bg-error"></div>
                <div class="flex items-center gap-4 w-full sm:w-auto flex-grow">
                    <div class="w-16 h-16 rounded-lg bg-surface-container-highest flex items-center justify-center flex-shrink-0 shadow-inner border border-outline-variant/50"><span class="material-symbols-outlined text-on-surface-variant text-2xl">build</span></div>
                    <div class="flex-grow min-w-0"><div class="flex justify-between items-center mb-1"><h2 class="font-bold text-[16px] text-primary truncate">#FAC-2024-028</h2><span class="text-[12px] text-on-surface-variant">01/09/23</span></div><div class="flex items-center gap-3"><span class="bg-error-container text-on-error-container text-[12px] px-2 py-0.5 rounded-full font-medium border border-error/20">Vencida</span><p class="text-[14px] font-bold text-on-surface">$450k</p></div></div>
                </div>
                <div class="flex justify-end items-center w-full sm:w-auto mt-2 sm:mt-0 pt-2 sm:pt-0 border-t sm:border-t-0 border-outline-variant"><button class="bg-primary text-on-primary text-[14px] px-5 py-2 rounded-lg font-bold shadow-sm hover:bg-primary/90 transition-colors">Pagar</button></div>
            </article>
            <!-- Invoice Card: Paid -->
            <article class="bg-surface-container-lowest border border-outline-variant rounded-xl flex flex-col sm:flex-row items-start sm:items-center gap-4 p-4 shadow-sm relative overflow-hidden opacity-90">
                <div class="absolute top-0 left-0 w-1.5 h-full bg-tertiary"></div>
                <div class="flex items-center gap-4 w-full sm:w-auto flex-grow">
                    <div class="w-16 h-16 rounded-lg bg-surface-container-highest flex items-center justify-center flex-shrink-0 shadow-inner border border-outline-variant/50"><span class="material-symbols-outlined text-on-surface-variant text-2xl">table_restaurant</span></div><div class="flex-grow min-w-0"><div class="flex justify-between items-center mb-1"><h2 class="font-bold text-[16px] text-primary truncate">#FAC-2024-015</h2><span class="text-[12px] text-on-surface-variant">12/08/23</span></div><div class="flex items-center gap-3"><span class="bg-tertiary-container/20 text-tertiary text-[12px] px-2 py-0.5 rounded-full font-medium border border-tertiary/20">Pagada</span><p class="text-[14px] font-bold text-on-surface">$1.2M</p></div></div>
                </div>
                <div class="flex justify-end items-center w-full sm:w-auto gap-2 mt-2 sm:mt-0 pt-2 sm:pt-0 border-t sm:border-t-0 border-outline-variant"><button class="text-primary p-2 rounded-lg border border-outline-variant hover:bg-surface-container transition-colors"><span class="material-symbols-outlined text-[20px]">visibility</span></button><button class="text-primary p-2 rounded-lg border border-outline-variant hover:bg-surface-container transition-colors"><span class="material-symbols-outlined text-[20px]">download</span></button></div>
            </article>
        </div>
        <section class="flex flex-col gap-6 mt-4">
            <h3 class="font-title-md text-title-md text-primary border-b border-outline-variant pb-2">Asistencia y Soporte</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- PQR -->
                <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-5 flex flex-col justify-between shadow-sm hover:shadow-md transition-shadow">
                    <div>
                        <div class="flex items-center gap-3 text-primary mb-2">
                            <div class="bg-primary-container/10 p-2 rounded-full"><span class="material-symbols-outlined text-[24px]">support_agent</span></div>
                            <h3 class="font-bold text-[18px]">PQR</h3>
                        </div>
                        <p class="text-[14px] text-on-surface-variant mb-4">¿Dudas o reclamos? Nuestro equipo está listo para ayudarte.</p>
                    </div>
                    <button class="bg-primary text-on-primary text-[14px] py-2.5 rounded-lg font-bold shadow-sm hover:bg-primary/90 transition-colors w-full">Radicar PQR</button>
                </div>
                <!-- Nuestros Productos -->
                <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-5 flex flex-col justify-between shadow-sm hover:shadow-md transition-shadow">
                    <div>
                        <div class="flex items-center gap-3 text-primary mb-2">
                            <div class="bg-primary-container/10 p-2 rounded-full"><span class="material-symbols-outlined text-[24px]">chair</span></div>
                            <h3 class="font-bold text-[18px]">Catálogo</h3>
                        </div>
                        <p class="text-[14px] text-on-surface-variant mb-4">Calidad artesanal en cada una de nuestras piezas certificadas.</p>
                    </div>
                    <button class="bg-surface text-primary border border-primary text-[14px] py-2.5 rounded-lg font-bold shadow-sm hover:bg-primary-container/10 transition-colors w-full">Ver Catálogo</button>
                </div>
                <!-- Métodos de Pago & Seguridad Combined -->
                <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-5 flex flex-col justify-between shadow-sm hover:shadow-md transition-shadow lg:col-span-1 md:col-span-2">
                    <div>
                        <div class="flex items-center gap-3 text-primary mb-2">
                            <div class="bg-primary-container/10 p-2 rounded-full"><span class="material-symbols-outlined text-[24px]">verified_user</span></div>
                            <span class="font-bold text-[18px]">Seguridad SSL</span>
                        </div>
                        <p class="text-[14px] text-on-surface-variant mb-4">Transacciones protegidas y ley de datos. Múltiples medios de pago disponibles.</p>
                    </div>
                    <div class="flex gap-4 opacity-70 items-center justify-start mt-2">
                        <span class="material-symbols-outlined text-primary text-[24px]">account_balance_wallet</span>
                        <span class="material-symbols-outlined text-primary text-[24px]">smartphone</span>
                        <span class="material-symbols-outlined text-primary text-[24px]">credit_card</span>
                        <span class="material-symbols-outlined text-primary text-[24px]">account_balance</span>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <!-- BottomNavBar -->
    <nav class="bg-surface-container-highest dark:bg-surface-container-lowest text-primary dark:text-primary-fixed-dim font-label-md text-label-md fixed bottom-0 w-full z-50 shadow-[0_-4px_12px_rgba(0,0,0,0.05)] flex justify-around items-center h-20 px-2 pb-safe md:hidden border-t border-outline-variant/30">
        <!-- Tab: Inicio -->
        <a class="flex flex-col items-center justify-center text-on-surface-variant hover:text-secondary transition-colors active:scale-90 duration-150 p-2" href="#">
            <span class="material-symbols-outlined mb-1" data-icon="home">home</span>
            <span class="">Inicio</span>
        </a>
        <!-- Tab: Catálogo -->
        <a class="flex flex-col items-center justify-center text-on-surface-variant hover:text-secondary transition-colors active:scale-90 duration-150 p-2" href="#">
            <span class="material-symbols-outlined mb-1" data-icon="menu_book">menu_book</span>
            <span class="">Catálogo</span>
        </a>
        <!-- Tab: Cotizaciones -->
        <a class="flex flex-col items-center justify-center text-on-surface-variant hover:text-secondary transition-colors active:scale-90 duration-150 p-2" href="#">
            <span class="material-symbols-outlined mb-1" data-icon="request_quote">request_quote</span>
            <span class="">Cotizaciones</span>
        </a>
        <!-- Tab: Pedidos -->
        <a class="flex flex-col items-center justify-center text-on-surface-variant hover:text-secondary transition-colors active:scale-90 duration-150 p-2" href="#">
            <span class="material-symbols-outlined mb-1" data-icon="shopping_bag">shopping_bag</span>
            <span class="">Pedidos</span>
        </a>
        <!-- Tab: Perfil (ACTIVE) -->
        <a class="flex flex-col items-center justify-center bg-primary text-on-primary rounded-xl px-5 py-1.5 shadow-sm hover:bg-primary/90 transition-colors active:scale-90 duration-150" href="#">
            <span class="material-symbols-outlined mb-0.5" data-icon="person">person</span>
            <span class="font-bold">Perfil</span>
        </a>
    </nav>
</body></html>