<body class="bg-surface text-on-surface antialiased min-h-screen relative font-body-md text-body-md">
    <!-- TopAppBar -->
    <header class="bg-primary dark:bg-primary-container text-on-primary dark:text-on-primary-container font-headline-lg-mobile text-headline-lg-mobile fixed top-0 w-full z-50 shadow-md flex justify-between items-center px-margin-mobile h-16 w-full">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined" data-icon="handyman">handyman</span>
            <span class="font-display-lg text-[24px] font-bold text-on-primary dark:text-on-primary-container">Carpintec</span>
        </div>
        <nav class="hidden md:flex items-center gap-6">
            <a class="font-label-md text-label-md text-on-primary hover:text-secondary-container transition-colors" href="#">Inicio</a>
            <a class="font-label-md text-label-md text-on-primary hover:text-secondary-container transition-colors" href="#">Catálogo</a>
            <a class="font-label-md text-label-md text-on-primary hover:text-secondary-container transition-colors" href="#">Perfil</a>
            <button class="font-label-md text-label-md bg-secondary-container text-on-secondary-container px-4 py-1.5 rounded-full hover:bg-secondary transition-colors active:scale-95 shadow-sm">Cerrar Sesión</button>
        </nav>
        <button class="md:hidden hover:bg-secondary dark:hover:bg-secondary-container transition-colors active:scale-95 duration-200 p-2 rounded-full flex items-center justify-center font-label-md text-label-md">
            <span class="material-symbols-outlined">menu</span>
        </button>
    </header>
    <!-- Main Content -->
    <main class="pt-24 pb-28 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto flex flex-col gap-8">
        <header class="mb-4"><h1 class="font-display-lg text-headline-lg md:text-display-lg text-primary border-b border-outline-variant pb-2">Mis Facturas</h1><p class="font-body-md text-body-md text-on-surface-variant mt-2 italic font-serif">Cada pieza cuenta una historia. Gracias por permitirnos ser parte de la tuya.</p></header>
        <div class="flex flex-col gap-4">
            <!-- Invoice Card: Pending -->
            <article class="bg-surface-container-lowest border border-outline-variant rounded-xl flex flex-col sm:flex-row items-start sm:items-center gap-4 p-4 shadow-sm relative overflow-hidden">
                <div class="absolute top-0 left-0 w-1.5 h-full bg-secondary-container"></div>
                <div class="flex items-center gap-4 w-full sm:w-auto flex-grow">
