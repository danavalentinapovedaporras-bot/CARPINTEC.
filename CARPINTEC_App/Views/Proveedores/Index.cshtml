                <span class="material-symbols-outlined">person_add</span>
                AGREGAR NUEVO PROVEEDOR
            </a>
        </section>
        <!-- KPI Summary Bento Grid -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
