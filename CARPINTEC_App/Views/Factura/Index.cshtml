    <script>
            // Simulation of real-time syncing from Cotización
            const qtyInput = document.getElementById('qty-input');
            const itemTotal = document.getElementById('item-total');
            const grandTotal = document.getElementById('grand-total');

            const unitPrice = 350000;
            const baseSubtotal = 2200000;
            const labor = 850000;

            qtyInput.addEventListener('input', (e) => {
                const qty = parseInt(e.target.value) || 0;
                const newTotal = qty * unitPrice;

                // Format currency
                const formatter = new Intl.NumberFormat('es-CO', {
                    style: 'currency',
                    currency: 'COP',
                    minimumFractionDigits: 0
                });

                itemTotal.innerText = formatter.format(newTotal).replace('COP', '$');

                // Calculate grand total logic
                const currentSubtotal = baseSubtotal + newTotal + labor;
                const discount = currentSubtotal * 0.10;
                const finalTotal = currentSubtotal - discount;

                grandTotal.innerText = formatter.format(finalTotal).replace('COP', '$');

                // Visual feedback
                grandTotal.classList.add('scale-110', 'transition-transform');
                setTimeout(() => grandTotal.classList.remove('scale-110'), 200);
            });
    </script>
