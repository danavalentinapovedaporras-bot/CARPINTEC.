@model CARPINTEC_App.Models.Usuario

@{
    Layout = null;
    ViewData["Title"] = "Crear Cuenta";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Crear Cuenta - Carpintec</title>

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: Arial, Helvetica, sans-serif;
            }

            body {
                background: url('/img/fondoLogin.jpg');
                background-size: cover;
                background-position: center;
                display: flex;
                justify-content: center;
                align-items: center;
                height: 100vh;
            }

            .contenedor {
                width: 430px;
                background: white;
                padding: 35px;
                border-radius: 12px;
                box-shadow: 0 0 20px rgba(0,0,0,.3);
            }

            h2 {
                text-align: center;
                color: #8b4513;
                margin-bottom: 25px;
            }

            label {
                font-weight: bold;
                display: block;
                margin-top: 10px;
            }

            input {
                width: 100%;
                padding: 12px;
                margin-top: 5px;
                margin-bottom: 15px;
                border-radius: 6px;
                border: 1px solid #ccc;
            }

            button {
                width: 100%;
                padding: 14px;
                background: #8b4513;
                color: white;
                border: none;
                border-radius: 6px;
                cursor: pointer;
                font-size: 18px;
            }

                button:hover {
                    background: #6d3510;
                }

            .mensaje {
                color: red;
                text-align: center;
                margin-bottom: 15px;
            }

            .ok {
                color: green;
                text-align: center;
                margin-bottom: 15px;
            }

            .login {
                text-align: center;
                margin-top: 20px;
            }

                .login a {
                    color: #8b4513;
                    text-decoration: none;
                    font-weight: bold;
                }
    </style>
</head>

<body>

    <div class="contenedor">

        <h2>Crear Cuenta</h2>

        @if (TempData["Error"] != null)
        {
            <div class="mensaje">
                @TempData["Error"]
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="ok">
                @TempData["Success"]
            </div>
        }

        <form asp-controller="Registro" asp-action="Registrar" method="post">

            <label>Nombre</label>
            <input asp-for="Nombre" required />

            <span asp-validation-for="Nombre"
                  style="color:red;"></span>

            <label>Apellido</label>
            <input asp-for="Apellido" required />

            <span asp-validation-for="Apellido"
                  style="color:red;"></span>


            <label>Correo</label>
            <input asp-for="Correo"
                   type="email"
                   required />

            <span asp-validation-for="Correo"
                  style="color:red;"></span>

            <label>Contraseña</label>
            <input asp-for="Contraseña"
                   type="password"
                   minlength="6"
                   required />

            <span asp-validation-for="Contraseña"
                  style="color:red;"></span>

            <label>Confirmar contraseña</label>
            <input type="password"
                   name="confirmarPassword"
                   minlength="6"
                   required />
            <button type="submit">
                Crear Cuenta
            </button>

        </form>

        <div class="login">
            ¿Ya tienes cuenta?<br />

            <a asp-controller="Login" asp-action="Index">
                Iniciar sesión
            </a>

        </div>

    </div>

</body>
</html>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}