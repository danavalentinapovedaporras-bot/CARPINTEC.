@model CARPINTEC_App.Models.Factura
@{
    Layout = null;
    ViewData["Title"] = "Factura";
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <title>Factura</title>

    <style>

            body {
                background: #ececec;
                font-family: Arial,Helvetica,sans-serif;
            }

            .factura {
                width: 950px;
                margin: 30px auto;
                background: white;
                padding: 45px;
                box-shadow: 0 0 20px rgba(0,0,0,.20);
            }

            .encabezado {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                border-bottom: 3px solid #7a4f24;
                padding-bottom: 20px;
            }

            .logo {
                font-size: 34px;
                color: #7a4f24;
                font-weight: bold;
            }

            .subtitulo {
                color: #666;
                margin-top: 5px;
            }

            .estado {
                display: inline-block;
                padding: 6px 15px;
                border-radius: 20px;
                font-weight: bold;
                color: white;
                margin-bottom: 15px;
            }

            .pagada {
                background: #28a745;
            }

            .pendiente {
                background: #ffc107;
                color: black;
            }

            .vencida {
                background: #dc3545;
            }

            .info {
                text-align: right;
            }

            .bloques {
                display: flex;
                justify-content: space-between;
                margin-top: 35px;
            }

            .caja {
                width: 45%;
                background: #f8f8f8;
                padding: 18px;
                border-radius: 10px;
            }

                .caja h3 {
                    margin-bottom: 12px;
                    color: #7a4f24;
                }

            table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 35px;
            }

            th {
                background: #7a4f24;
                color: white;
                padding: 12px;
            }

            td {
                padding: 12px;
                border-bottom: 1px solid #ddd;
            }

            .resumen {
                width: 350px;
                margin-left: auto;
                margin-top: 35px;
            }

                .resumen table {
                    margin-top: 0;
                }

                .resumen td {
                    border: none;
                }

            .total {
                font-size: 22px;
                font-weight: bold;
                border-top: 2px solid #000;
            }

            .obs {
                margin-top: 35px;
                background: #f7f7f7;
                padding: 15px;
                border-radius: 8px;
            }

            .botones {
                margin-top: 35px;
                text-align: center;
            }

            button {
                background: #7a4f24;
                color: white;
                border: none;
                padding: 14px 25px;
                border-radius: 8px;
                cursor: pointer;
                font-size: 16px;
            }

            @@media print {

                body {
                    background: white;
                }

                .factura {
                    box-shadow: none;
                    margin: 0;
                    width: 100%;
                }

                .botones {
                    display: none;
                }
            }

    </style>

</head>

<body>

    <div class="factura">

        <div class="encabezado">

            <div>

                <div class="logo">

                    CARPINTEC

                </div>

                <div class="subtitulo">

                    Carpintería y Diseño de Muebles

                </div>

            </div>

            <div class="info">

                @if (Model.Estado == "Pagada")
                {
                    <span class="estado pagada">PAGADA</span>
                }

                @if (Model.Estado == "Pendiente")
                {
                    <span class="estado pendiente">PENDIENTE</span>
                }

                @if (Model.Estado == "Vencida")
                {
                    <span class="estado vencida">VENCIDA</span>
                }

                <p><b>Factura:</b> @Model.Folio</p>

                <p><b>Fecha:</b> @Model.Fecha.ToString("dd/MM/yyyy")</p>

                <p><b>Vencimiento:</b> @(Model.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "-")</p>

            </div>

        </div>

        <div class="bloques">

            <div class="caja">

                <h3>EMISOR</h3>

                <b>CARPINTEC S.A.S.</b><br />

                Carpintería y Diseño<br />

                Chía - Cundinamarca<br />

                Colombia

            </div>

            <div class="caja">

                <h3>CLIENTE</h3>

                <b>@Model.Cliente</b>

            </div>

        </div>

        <table>

            <thead>

                <tr>

                    <th>Descripción</th>

                    <th>Cantidad</th>

                    <th>Precio</th>

                    <th>Total</th>

                </tr>

            </thead>

            <tbody>

                @if (Model.DetallesFactura != null && Model.DetallesFactura.Any())
                {
                    @foreach (var item in Model.DetallesFactura)
                    {
                        <tr>

                            <td>@item.Producto?.Nombre</td>

                            <td style="text-align:center">
                                @item.Cantidad
                            </td>

                            <td style="text-align:right">
                                $@item.PrecioUnitario.ToString("N0")
                            </td>

                            <td style="text-align:right">
                                $@item.Subtotal.ToString("N0")
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" style="text-align:center">
                            No hay productos registrados para esta factura.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

        <div class="resumen">

            <table>

                <tr>

                    <td>Subtotal</td>

                    <td style="text-align:right">
                        $@(Model.Subtotal?.ToString("N0") ?? "0")
                    </td>

                </tr>

                <tr>

                    <td>IVA</td>

                    <td style="text-align:right">
                        $@(Model.IVA?.ToString("N0") ?? "0")
                    </td>

                </tr>

                <tr>

                    <td>Descuento</td>

                    <td style="text-align:right">
                        $@(Model.Descuento?.ToString("N0") ?? "0")
                    </td>

                </tr>

                <tr>

                    <td>Instalación</td>

                    <td style="text-align:right">
                        $@(Model.CostoInstalacion?.ToString("N0") ?? "0")
                    </td>

                </tr>

                <tr>

                    <td>Transporte</td>

                    <td style="text-align:right">
                        $@(Model.CostoTransporte?.ToString("N0") ?? "0")
                    </td>

                </tr>

                <tr class="total">

                    <td>TOTAL</td>

                    <td style="text-align:right">

                        $@Model.Total.ToString("N0")

                    </td>

                </tr>

            </table>

        </div>

        <div class="obs">

            <b>Método de pago:</b>

            @(Model.MetodoPago ?? "-")

            <br /><br />

            <b>Observaciones:</b>

            @(Model.Observaciones ?? "Sin observaciones")

        </div>

        <div class="botones">

            <button onclick="window.print()">

                🖨 Imprimir Factura

            </button>

        </div>

    </div>

</body>

</html>