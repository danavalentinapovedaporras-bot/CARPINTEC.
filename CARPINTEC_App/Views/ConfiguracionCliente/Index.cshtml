@{
    Layout = null;
}
<!DOCTYPE html>
<html class="light" lang="es" style="">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title class="">Configuración</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&amp;family=Work+Sans:wght@400;500;600&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <script id="tailwind-config">
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        "colors": {
                            "surface-dim": "#e4d7d4",
                            "surface-variant": "#ede0dc",
                            "on-secondary-fixed": "#321200",
                            "inverse-surface": "#362f2c",
                            "inverse-on-surface": "#fbeeea",
                            "surface-container-low": "#fef1ed",
                            "tertiary": "#4d3f20",
                            "surface": "#fff8f6",
                            "on-secondary-fixed-variant": "#763400",
                            "tertiary-fixed": "#f7e0b5",
                            "secondary-container": "#fd8a3e",
                            "background": "#fff8f6",
                            "tertiary-fixed-dim": "#dac49b",
                            "primary-fixed-dim": "#ffb68c",
                            "primary-container": "#8b4513",
                            "on-secondary-container": "#672c00",
                            "on-error-container": "#93000a",
                            "surface-bright": "#fff8f6",
                            "on-tertiary-container": "#e2cca2",
                            "outline-variant": "#dac2b6",
                            "on-primary-fixed": "#321200",
                            "error": "#ba1a1a",
                            "on-tertiary-fixed": "#251a01",
                            "on-surface": "#201a18",
                            "on-primary": "#ffffff",
                            "primary-fixed": "#ffdbc9",
                            "error-container": "#ffdad6",
                            "on-background": "#201a18",
                            "surface-container-high": "#f3e5e1",
                            "on-tertiary-fixed-variant": "#544525",
                            "outline": "#877369",
                            "on-primary-fixed-variant": "#753401",
                            "surface-container-highest": "#ede0dc",
                            "secondary": "#9a4600",
                            "secondary-fixed-dim": "#ffb68d",
                            "secondary-fixed": "#ffdbc9",
                            "surface-tint": "#934b19",
                            "on-secondary": "#ffffff",
                            "on-error": "#ffffff",
                            "tertiary-container": "#665635",
                            "surface-container-lowest": "#ffffff",
                            "primary": "#6c2f00",
                            "on-surface-variant": "#54433a",
                            "on-primary-container": "#ffc29f",
                            "surface-container": "#f9ebe7",
                            "on-tertiary": "#ffffff",
                            "inverse-primary": "#ffb68c"
                        },
                        "borderRadius": {
                            "DEFAULT": "0.125rem",
                            "lg": "0.25rem",
                            "xl": "0.5rem",
                            "full": "0.75rem"
                        },
                        "spacing": {
                            "base": "8px",
                            "gutter": "24px",
                            "margin-desktop": "64px",
                            "container-max": "1280px",
                            "margin-mobile": "16px"
                        },
                        "fontFamily": {
                            "display-lg": ["Montserrat"],
                            "title-md": ["Montserrat"],
                            "body-md": ["Work Sans"],
                            "headline-lg": ["Montserrat"],
                            "headline-lg-mobile": ["Montserrat"],
                            "label-md": ["Work Sans"],
                            "body-lg": ["Work Sans"]
                        },
                        "fontSize": {
                            "display-lg": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                            "title-md": ["20px", { "lineHeight": "28px", "fontWeight": "600" }],
                            "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                            "headline-lg": ["32px", { "lineHeight": "40px", "fontWeight": "700" }],
                            "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "700" }],
                            "label-md": ["14px", { "lineHeight": "20px", "letterSpacing": "0.05em", "fontWeight": "500" }],
                            "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }]
                        }
                    },
                },
            }
    </script>
    <style>
            .material-symbols-outlined {
                font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            }

            .form-input-focus:focus {
                outline: none;
                border-color: #6c2f00;
                box-shadow: 0 0 0 2px rgba(108, 47, 0, 0.1);
            }

            .toggle-checkbox:checked + .toggle-label {
                background-color: #6c2f00;
            }

                .toggle-checkbox:checked + .toggle-label .toggle-dot {
                    transform: translateX(100%);
                }
    </style>
    <style>
            body {
                min-height: max(884px, 100dvh);
            }
    </style>
</head>
<body class="bg-background text-on-background font-body-md min-h-screen pb-24">
    <!-- TopAppBar -->
    <header class="fixed top-0 w-full z-50 bg-primary dark:bg-primary-container text-on-primary dark:text-on-primary-container shadow-md border-b-4 border-secondary dark:border-secondary-container flex justify-between items-center px-margin-mobile h-16 md:px-margin-desktop">
        <div class="flex items-center gap-3">
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuC9R-VJy5U5W3YrOWnDdSivSPKBIqbrd-fxwnJLMRvbNW5uiYQpU-t9KfLE3axs7AZhXlmVJrmWAKGld09TBKIMpFqTF9MTjn0AjDyaKj39-BmtUGw0JfsdlFzZ3u_os-WiazIiGj1GDvMGk3GgzmRV1TDAHsJ0aUDqw0b2L0q_ZX4E736VrGAhaRmSCfD9o2lAC4je29YJMXn0A3e51Ypiys0X9Sgaurt5iMUfou7uN3VHaFLqY7FY33XsrsInsMSwFwjWfNdlVy1a" alt="Carpintec Logo" class="h-8 w-8 object-contain">
            <span class="font-display-lg text-headline-lg-mobile font-bold text-on-primary dark:text-on-primary-container">Carpintec</span>
        </div>
        <div class="hidden md:flex gap-8 items-center">
            <a class="text-on-primary-fixed-variant opacity-80 font-label-md text-label-md hover:opacity-100 transition-opacity" href="#">Inicio</a>
            <a class="text-on-primary-fixed-variant opacity-80 font-label-md text-label-md hover:opacity-100 transition-opacity" href="#">Catálogo</a>
            <a class="text-on-primary font-bold border-b-2 border-on-primary font-label-md text-label-md" href="#">Configuración</a>
        </div>
        <button class="bg-secondary px-4 py-1.5 rounded-lg text-on-primary font-label-md text-label-md hover:bg-secondary-container transition-colors active:scale-95 duration-200">
            Contacto
        </button>
    </header>
    <main class="pt-24 pb-8 px-margin-mobile max-w-container-max mx-auto md:px-gutter">
        <!-- Hero Branding Section -->
        <div class="mb-12 relative h-48 md:h-64 rounded-xl overflow-hidden border-4 border-primary shadow-lg">
            <img alt="Carpintec Workshop" class="w-full h-full object-cover opacity-90" data-alt="A professional woodworking workshop with high-end machinery and artisanal tools arranged neatly. The lighting is warm and natural, illuminating fine wood dust in the air. Rich mahogany and oak textures dominate the frame, creating an atmosphere of craftsmanship and heritage. The overall aesthetic is clean, corporate yet deeply tactile and authentic." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCkuJyoI-x5geOmX-DcURIaKs_zwY714Whto8-zVV6mV8yN43IYWGYE_35RjRPHdBygHtAgNn9D2Paxp0u_qzxtNU4Xr7sXEf_-GgUFqRk7WPy1c18j4xmE564vm2sYP0_dOJomQMkuEKZLWm6VqB8Qxs75alC9eNJRbC8TCKWhJPqxlxmHx9AxkX1pcqocd__Uu8HKpYxqiw2mRKTbH6wfK5ENe0AcJWPXXwScNI_uuOW4HU-hQ_MxAHmnkpKxTgqbdbjoJcOWgGl5">
            <div class="absolute inset-0 bg-gradient-to-t from-primary/80 to-transparent flex flex-col justify-end p-8">
                <h1 class="text-on-primary font-headline-lg text-headline-lg-mobile md:text-headline-lg">Configuración</h1>
                <p class="text-on-primary/90 font-body-md">Administra tu perfil y seguridad con la precisión de un maestro carpintero.</p>
            </div>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
            <!-- Sidebar / Content Navigation (Desktop) -->
            <div class="hidden lg:block lg:col-span-3">
                <nav class="sticky top-28 bg-surface-container-low border-2 border-outline-variant p-4 space-y-2">
                    <a class="flex items-center gap-3 px-4 py-3 bg-secondary-container text-on-secondary-container font-title-md text-title-md rounded-lg" href="#personal">
                        <span class="material-symbols-outlined" data-icon="person">person</span> Datos Personales
                    </a>
                    <a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-variant transition-colors font-title-md text-title-md rounded-lg" href="#security">
                        <span class="material-symbols-outlined" data-icon="security">security</span> Seguridad
                    </a>
                    <a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-variant transition-colors font-title-md text-title-md rounded-lg" href="#notifications">
                        <span class="material-symbols-outlined" data-icon="notifications">notifications</span> Preferencias
                    </a>
                </nav>
            </div>
            <!-- Settings Content -->
            <div class="lg:col-span-9 space-y-8">
                <!-- Section 1: Personal Information -->
                <section class="bg-surface border-4 border-primary p-6 md:p-8" id="personal">
                    <div class="flex items-center gap-2 mb-6 text-primary">
                        <span class="material-symbols-outlined" data-icon="badge">badge</span>
                        <h2 class="font-headline-lg text-headline-lg-mobile">Información Personal</h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="flex flex-col gap-2">
                            <label class="text-on-surface font-label-md text-label-md">Nombre Completo</label>
                            <input class="bg-surface-container-lowest border border-outline p-3 font-body-md form-input-focus" type="text" value="Artesano Principal">
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="text-on-surface font-label-md text-label-md">Correo Electrónico</label>
                            <input class="bg-surface-container-lowest border border-outline p-3 font-body-md form-input-focus" type="email" value="contacto@carpintec.com">
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="text-on-surface font-label-md text-label-md">Teléfono</label>
                            <input class="bg-surface-container-lowest border border-outline p-3 font-body-md form-input-focus" type="tel" value="+34 600 000 000">
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="text-on-surface font-label-md text-label-md">Dirección de Taller</label>
                            <input class="bg-surface-container-lowest border border-outline p-3 font-body-md form-input-focus" type="text" value="Calle de la Madera, 12">
                        </div>
                    </div>
                </section>
                <!-- Section 2: Security Section -->
                <section class="bg-surface-container-high border-2 border-primary p-6 md:p-8" id="security">
                    <div class="flex items-center gap-2 mb-6 text-primary">
                        <span class="material-symbols-outlined" data-icon="lock_reset">lock_reset</span>
                        <h2 class="font-headline-lg text-headline-lg-mobile">Gestión de Contraseñas</h2>
                    </div>
                    <div class="space-y-6 max-w-2xl">
                        <div class="flex flex-col gap-2">
                            <label class="text-on-surface font-label-md text-label-md">Contraseña Actual</label>
                            <input class="bg-surface-container-lowest border border-outline p-3 font-body-md form-input-focus" placeholder="••••••••" type="password">
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="flex flex-col gap-2">
                                <label class="text-on-surface font-label-md text-label-md">Nueva Contraseña</label>
                                <input class="bg-surface-container-lowest border border-outline p-3 font-body-md form-input-focus" placeholder="Mínimo 8 caracteres" type="password">
                            </div>
                            <div class="flex flex-col gap-2">
                                <label class="text-on-surface font-label-md text-label-md">Confirmar Contraseña</label>
                                <input class="bg-surface-container-lowest border border-outline p-3 font-body-md form-input-focus" placeholder="Repite la contraseña" type="password">
                            </div>
                        </div>


                    </div>
                </section>
                <!-- Section 3: Preferences -->
                <section class="bg-surface border-l-8 border-secondary p-6 md:p-8" id="notifications">
                    <div class="flex items-center gap-2 mb-6 text-secondary">
                        <span class="material-symbols-outlined" data-icon="notifications_active">notifications_active</span>
                        <h2 class="font-headline-lg text-headline-lg-mobile">Preferencias de Notificación</h2>
                    </div>
                    <div class="space-y-4">
                        <div class="flex items-center justify-between py-3 border-b border-surface-variant">
                            <div>
                                <p class="font-title-md text-title-md text-on-surface">Notificaciones por Email</p>
                                <p class="font-body-md text-on-surface-variant">Recibe estados de pedidos y facturas por correo.</p>
                            </div>
                            <div class="relative inline-block w-12 mr-2 align-middle select-none">
                                <input checked="" class="toggle-checkbox absolute block w-6 h-6 rounded-full bg-white border-4 border-outline-variant appearance-none cursor-pointer transition-transform duration-200 ease-in-out top-0 left-0" id="mail-toggle" name="toggle-mail" type="checkbox">
                                <label class="toggle-label block overflow-hidden h-6 rounded-full bg-surface-dim cursor-pointer transition-colors duration-200 ease-in-out" for="mail-toggle"></label>
                            </div>
                        </div>
                        <div class="flex items-center justify-between py-3 border-b border-surface-variant">
                            <div>
                                <p class="font-title-md text-title-md text-on-surface">Notificaciones Push</p>
                                <p class="font-body-md text-on-surface-variant">Avisos instantáneos sobre el progreso de tus piezas.</p>
                            </div>
                            <div class="relative inline-block w-12 mr-2 align-middle select-none">
                                <input class="toggle-checkbox absolute block w-6 h-6 rounded-full bg-white border-4 border-outline-variant appearance-none cursor-pointer transition-transform duration-200 ease-in-out top-0 left-0" id="push-toggle" name="toggle-push" type="checkbox">
                                <label class="toggle-label block overflow-hidden h-6 rounded-full bg-surface-dim cursor-pointer transition-colors duration-200 ease-in-out" for="push-toggle"></label>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- Form Actions -->
                <div class="flex flex-col sm:flex-row items-center justify-end gap-4 pt-8">
                    <button class="w-full sm:w-auto px-8 py-3 bg-transparent border-2 border-primary text-primary font-title-md text-title-md hover:bg-secondary-container/10 transition-all active:scale-95 duration-150">
                        Cancelar
                    </button>
                    <button class="w-full sm:w-auto px-10 py-3 bg-primary text-on-primary font-headline-lg text-headline-lg-mobile md:text-headline-lg rounded-sm hover:bg-secondary transition-all shadow-md active:scale-95 duration-200">
                        Guardar Cambios
                    </button>
                </div>
            </div>
        </div>
    </main>
    <!-- BottomNavBar -->
    <nav class="fixed bottom-0 w-full z-50 bg-surface-container-highest dark:bg-surface-container-lowest border-t-2 border-primary dark:border-outline-variant shadow-[0_-4px_12px_rgba(0,0,0,0.05)] flex justify-around items-center h-20 px-2 pb-safe">
        <button class="flex flex-col items-center justify-center text-on-surface-variant hover:text-secondary transition-colors active:scale-90 duration-150">
            <span class="material-symbols-outlined" data-icon="home">home</span>
            <span class="font-label-md text-label-md">Inicio</span>
        </button>
        <button class="flex flex-col items-center justify-center text-on-surface-variant hover:text-secondary transition-colors active:scale-90 duration-150">
            <span class="material-symbols-outlined" data-icon="menu_book">menu_book</span>
            <span class="font-label-md text-label-md">Catálogo</span>
        </button>
        <button class="flex flex-col items-center justify-center text-on-surface-variant hover:text-secondary transition-colors active:scale-90 duration-150">
            <span class="material-symbols-outlined" data-icon="request_quote">request_quote</span>
            <span class="font-label-md text-label-md">Cotizaciones</span>
        </button>
        <button class="flex flex-col items-center justify-center text-on-surface-variant hover:text-secondary transition-colors active:scale-90 duration-150">
            <span class="material-symbols-outlined" data-icon="shopping_bag">shopping_bag</span>
            <span class="font-label-md text-label-md">Pedidos</span>
        </button>
        <button class="flex flex-col items-center justify-center bg-primary text-on-primary rounded-full px-4 py-1 active:scale-90 duration-150">
            <span class="material-symbols-outlined" data-icon="person">person</span>
            <span class="font-label-md text-label-md">Perfil</span>
        </button>
    </nav>
    <script>
            // Simple micro-interaction for smooth scrolling to sections
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function(e) {
                    e.preventDefault();
                    document.querySelector(this.getAttribute('href')).scrollIntoView({
                        behavior: 'smooth'
                    });
                });
            });

            // Toggle Switch functionality visual feedback
            const toggles = document.querySelectorAll('.toggle-checkbox');
            toggles.forEach(toggle => {
                toggle.addEventListener('change', function() {
                    const parent = this.closest('div.flex');
                    if (this.checked) {
                        console.log('Preference enabled');
                    } else {
                        console.log('Preference disabled');
                    }
                });
            });
    </script>




    <div id="success-toast" class="fixed top-24 left-1/2 -translate-x-1/2 z-[60] flex items-center gap-3 bg-surface-container-highest border-l-4 border-secondary px-6 py-4 shadow-xl transition-all duration-300 transform -translate-y-full opacity-0 pointer-events-none">
        <span class="material-symbols-outlined text-secondary">check_circle</span>
        <span class="font-title-md text-title-md text-on-surface">¡Cambios guardados correctamente!</span>
    </div>
    <script>
            (function() {
                const saveBtn = document.querySelector('button.bg-primary.text-on-primary.font-headline-lg');
                const toast = document.getElementById('success-toast');

                if (saveBtn && toast) {
                    saveBtn.addEventListener('click', () => {
                        // Show toast
                        toast.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
                        toast.classList.add('translate-y-0', 'opacity-100');

                        // Hide after 3s
                        setTimeout(() => {
                            toast.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
                            toast.classList.remove('translate-y-0', 'opacity-100');
                        }, 3000);
                    });
                }
            })();
    </script></body>
</html>