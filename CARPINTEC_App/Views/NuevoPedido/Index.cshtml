@{
    Layout = null;
}
<!DOCTYPE html>

<html class="light" lang="es" style="width: 1280px; height: 1435px; overflow: hidden; position: relative;">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Carpintec - Nuevo Pedido</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&amp;family=Work+Sans:wght@400;500&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <style>
            .material-symbols-outlined {
                font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            }

            .active-priority {
                outline: 2px solid #000000;
                outline-offset: 2px;
            }
    </style>
    <script id="tailwind-config">
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        "colors": {
                            "inverse-primary": "#e1c299",
                            "on-primary-fixed-variant": "#584324",
                            "surface-container-highest": "#e4e2dd",
                            "on-tertiary-fixed": "#0e1c2f",
                            "on-background": "#000000",
                            "on-tertiary-container": "#3d495f",
                            "outline-variant": "#d1c5b8",
                            "secondary": "#5f5e5e",
                            "tertiary-fixed-dim": "#bac7e1",
                            "secondary-fixed-dim": "#c8c6c5",
                            "tertiary-fixed": "#d6e3fe",
                            "error": "#ba1a1a",
                            "primary-fixed": "#feddb3",
                            "on-primary-container": "#000000",
                            "on-secondary-fixed-variant": "#474747",
                            "on-secondary": "#ffffff",
                            "surface-container-lowest": "#ffffff",
                            "inverse-on-surface": "#f2f1ec",
                            "surface-dim": "#dbdad5",
                            "surface-container": "#f0eee9",
                            "error-container": "#ffdad6",
                            "on-secondary-fixed": "#1b1c1c",
                            "on-error": "#ffffff",
                            "on-error-container": "#93000a",
                            "surface-container-high": "#eae8e3",
                            "inverse-surface": "#30312e",
                            "on-tertiary-fixed-variant": "#3b475d",
                            "on-primary-fixed": "#000000",
                            "secondary-fixed": "#e4e2e1",
                            "surface": "#fbf9f4",
                            "primary-fixed-dim": "#e1c299",
                            "primary": "#D2B48C",
                            "on-secondary-container": "#656464",
                            "on-surface-variant": "#4d453c",
                            "background": "#fbf9f4",
                            "surface-tint": "#D2B48C",
                            "surface-bright": "#fbf9f4",
                            "on-surface": "#000000",
                            "tertiary": "#525f76",
                            "on-primary": "#000000",
                            "surface-container-low": "#f5f3ee",
                            "secondary-container": "#e4e2e1",
                            "outline": "#7f766a",
                            "surface-variant": "#e4e2dd",
                            "tertiary-container": "#acb9d3",
                            "primary-container": "#D2B48C",
                            "on-tertiary": "#ffffff"
                        },
                        "borderRadius": {
                            "DEFAULT": "0.25rem",
                            "lg": "0.5rem",
                            "xl": "0.75rem",
                            "full": "9999px"
                        },
                        "spacing": {
                            "sidebar-width": "280px",
                            "base": "8px",
                            "margin-desktop": "40px",
                            "margin-mobile": "16px",
                            "card-padding": "24px",
                            "table-cell-padding": "12px 16px",
                            "gutter": "24px"
                        },
                        "fontFamily": {
                            "headline-lg": ["Manrope"],
                            "body-lg": ["Manrope"],
                            "body-md": ["Manrope"],
                            "headline-lg-mobile": ["Manrope"],
                            "data-table": ["Work Sans"],
                            "label-md": ["Work Sans"],
                            "headline-md": ["Manrope"],
                            "title-md": ["Manrope"],
                            "display-lg": ["Manrope"]
                        },
                        "fontSize": {
                            "headline-lg": ["32px", { "lineHeight": "40px", "fontWeight": "600" }],
                            "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                            "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                            "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                            "data-table": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                            "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "500" }],
                            "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                            "title-md": ["18px", { "lineHeight": "24px", "fontWeight": "600" }],
                            "display-lg": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }]
                        }
                    },
                },
            }
    </script>
</head>
<body class="bg-background text-on-background font-body-md min-h-screen flex">
    <!-- Sidebar (Shared Component) -->
    <!-- Main Content Canvas -->
    <main class="flex-1 flex flex-col min-h-screen">
        <!-- TopAppBar (Shared Component) -->
        <header class="w-full h-16 bg-surface flex items-center justify-between px-margin-desktop border-b border-outline-variant z-40">
            <div class="flex items-center gap-4">
                <button class="material-symbols-outlined p-2 hover:bg-surface-container-high rounded-full transition-colors text-on-surface">menu_open</button>
                <div class="relative group">
                    <input class="pl-10 pr-4 py-2 bg-surface-container rounded-full border-none focus:ring-2 focus:ring-primary w-64 text-body-md transition-all text-on-surface" placeholder="Buscar en el sistema..." type="text" />
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface">search</span>
                </div>
            </div>
            <div class="flex items-center gap-6">
                <div class="flex items-center gap-3 cursor-pointer active:opacity-80 transition-colors hover:bg-surface-container-high p-2 rounded-lg">
                    <span class="font-label-md text-label-md text-on-surface font-bold">Admin </span>
                    <div class="w-8 h-8 rounded-full overflow-hidden bg-primary flex items-center justify-center">
                        <img class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAveAnzQLOBWIYhhoLf_IBOdr2e7GU2gIcb90Rrm_-4tVkaH26eiu6vSts36kkDfltXgM9Kz6f7HQHgP0c2tjbkEeIcRZJMiVe4nHf8MzUOCP2v-KFcWOKmBsrr36iqJDpaD0Kn69yzor_np2-w8To-BegcFiAEPpIWgagNnLKy7s7uRto0eRKYRHgXcSoE-3pigO7V_JzZetl0sbpW2aX_zhk_-VsC1p2E06ZCnbchLT31NF6PPHsVYg" />
                    </div>
                </div>
            </div>
        </header>
        <!-- Content Area -->
        <div class="p-margin-desktop space-y-8 max-w-7xl mx-auto w-full">
            <!-- Page Header -->
            <div class="flex justify-between items-start">
                <button class="flex items-center gap-1 text-black hover:opacity-70 transition-opacity mb-4" onclick="window.history.back()">
                    <span class="material-symbols-outlined text-lg">arrow_back</span>
                    <span class="font-label-md text-label-md uppercase tracking-widest">Volver</span>
                </button>
                <div class="">
                    <h2 class="font-headline-lg text-headline-lg text-on-surface">Nuevo Pedido</h2>
                </div>
            </div>
            <!-- Bento Grid Layout -->
            <div class="grid grid-cols-12 gap-gutter">
                <!-- Main Form Column -->
                <div class="col-span-8 space-y-gutter">
                    <!-- Client Information Card -->
                    <section class="bg-surface-container-lowest p-card-padding rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-surface-container-high">
                        <div class="flex items-center gap-2 mb-6 text-on-surface">
                            <span class="material-symbols-outlined">person</span>
                            <h3 class="font-title-md text-title-md">Información del Cliente</h3>
                        </div>
                        <div class="space-y-4">
                            <div class="relative">
                                <label class="block font-label-md text-label-md text-on-surface-variant mb-2">Seleccionar Cliente</label>
                                <div class="relative">
                                    <input class="w-full pl-10 pr-4 py-3 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-primary transition-all text-on-surface" placeholder="Buscar por nombre o ID (ej. Ricardo Mendoza, Sofía Ortiz)" type="text" />
                                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
                                </div>
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                                <div class="p-4 rounded-lg border border-primary bg-primary/10 flex items-center justify-between group cursor-pointer hover:bg-primary/20 transition-all">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-on-surface font-bold">RM</div>
                                        <div>
                                            <p class="font-bold text-on-surface">Ricardo Mendoza</p>
                                            <p class="text-xs text-on-surface-variant">Cliente Premium • Ciudad de México</p>
                                        </div>
                                    </div>
                                    <span class="material-symbols-outlined text-on-surface opacity-0 group-hover:opacity-100 transition-opacity">check_circle</span>
                                </div>
                                <div class="p-4 rounded-lg border border-outline-variant hover:border-primary transition-all flex items-center justify-between group cursor-pointer hover:bg-primary/5">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface font-bold">SO</div>
                                        <div>
                                            <p class="font-bold text-on-surface">Sofía Ortiz</p>
                                            <p class="text-xs text-on-surface-variant">Venta Mayorista • Guadalajara</p>
                                        </div>
                                    </div>
                                    <span class="material-symbols-outlined text-on-surface-variant/40 group-hover:text-on-surface transition-colors">add_circle</span>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- Product Details Card -->
                    <section class="bg-surface-container-lowest p-card-padding rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-surface-container-high">
                        <div class="flex items-center gap-2 mb-6 text-on-surface">
                            <span class="material-symbols-outlined">straighten</span>
                            <h3 class="font-title-md text-title-md">Detalles del Producto</h3>
                        </div>
                        <div class="grid grid-cols-2 gap-6">
                            <div class="col-span-2">
                                <label class="block font-label-md text-label-md text-on-surface-variant mb-2">Nombre del Producto</label>
                                <input class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-primary transition-all text-on-surface" placeholder="Ej. Cocina Integral Roble con Acabado Mate" type="text" />
                            </div>
                            <div>
                                <label class="block font-label-md text-label-md text-on-surface-variant mb-2">Tipo de Madera / Material</label>
                                <select class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-primary appearance-none transition-all text-on-surface">
                                    <option>Seleccione una opción</option>
                                    <option>Roble Macizo</option>
                                    <option>Nogal Americano</option>
                                    <option>MDF Hidrófugo</option>
                                    <option>Pino Premium</option>
                                    <option>Cedro Rojo</option>
                                </select>
                            </div>
                            <div>
                                <label class="block font-label-md text-label-md text-on-surface-variant mb-2">Cantidad de Unidades</label>
                                <input class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-primary transition-all text-on-surface" min="1" type="number" value="1" />
                            </div>
                        </div>
                        <!-- Dimensions Row -->
                        <div class="mt-6">
                            <p class="block font-label-md text-label-md text-on-surface-variant mb-3">Dimensiones del Mueble (cm)</p>
                            <div class="grid grid-cols-3 gap-4">
                                <div class="relative">
                                    <input class="w-full pl-4 pr-12 py-3 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary transition-all text-on-surface" placeholder="Ancho" type="number" />
                                    <span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs font-bold text-on-surface-variant">cm</span>
                                </div>
                                <div class="relative">
                                    <input class="w-full pl-4 pr-12 py-3 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary transition-all text-on-surface" placeholder="Alto" type="number" />
                                    <span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs font-bold text-on-surface-variant">cm</span>
                                </div>
                                <div class="relative">
                                    <input class="w-full pl-4 pr-12 py-3 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary transition-all text-on-surface" placeholder="Prof." type="number" />
                                    <span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs font-bold text-on-surface-variant">cm</span>
                                </div>
                            </div>
                        </div>
                        <!-- Priority Selection -->
                        <div class="mt-8">
                            <label class="block font-label-md text-label-md text-on-surface-variant mb-3">Prioridad de Producción</label>
                            <div class="flex gap-4">
                                <button class="flex-1 py-4 px-6 rounded-lg border-2 border-outline-variant flex flex-col items-center gap-2 hover:bg-surface-container-high transition-all" onclick="this.parentElement.querySelectorAll('button').forEach(b =&gt; b.classList.remove('active-priority')); this.classList.add('active-priority')" type="button">
                                    <span class="material-symbols-outlined text-on-surface-variant">event_note</span>
                                    <span class="font-bold text-on-surface text-sm">Estándar</span>
                                    <span class="text-[10px] text-on-surface-variant uppercase tracking-wider">15-20 días hábiles</span>
                                </button>
                                <button class="flex-1 py-4 px-6 rounded-lg border-2 border-primary bg-primary text-black flex flex-col items-center gap-2 active-priority" onclick="this.parentElement.querySelectorAll('button').forEach(b =&gt; b.classList.remove('active-priority')); this.classList.add('active-priority')" type="button">
                                    <span class="material-symbols-outlined">bolt</span>
                                    <span class="font-bold text-sm">Alta</span>
                                    <span class="text-[10px] opacity-80 uppercase tracking-wider font-bold">7-10 días hábiles</span>
                                </button>
                                <button class="flex-1 py-4 px-6 rounded-lg border-2 border-error/20 bg-error/5 text-error flex flex-col items-center gap-2 hover:bg-error/10 transition-all" onclick="this.parentElement.querySelectorAll('button').forEach(b =&gt; b.classList.remove('active-priority')); this.classList.add('active-priority')" type="button">
                                    <span class="material-symbols-outlined">warning</span>
                                    <span class="font-bold text-sm">Urgente</span>
                                    <span class="text-[10px] opacity-70 uppercase tracking-wider font-bold">48-72 horas</span>
                                </button>
                            </div>
                        </div>
                    </section>
                    <!-- Workshop Notes -->
                    <section class="bg-surface-container-lowest p-card-padding rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-surface-container-high">
                        <div class="flex items-center gap-2 mb-4 text-on-surface">
                            <span class="material-symbols-outlined">edit_note</span>
                            <h3 class="font-title-md text-title-md">Notas de Taller</h3>
                        </div>
                        <textarea class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-primary transition-all text-body-md text-on-surface" placeholder="Instrucciones especiales para los ebanistas (ej. tipo de herrajes, veteado de madera, acabados de barniz...)" rows="4"></textarea>
                    </section>
                </div>
                <!-- Summary Panel Column -->
                <div class="col-span-4 space-y-gutter">
                    <div class="sticky top-gutter space-y-gutter">
                        <!-- Summary Card -->
                        <section class="bg-primary text-black p-6 rounded-2xl shadow-xl overflow-hidden relative">
                            <h3 class="font-title-md text-title-md mb-6 flex items-center gap-2 border-b border-black/10 pb-4">
                                <span class="material-symbols-outlined">fact_check</span>
                                Resumen del Pedido
                            </h3>
                            <div class="space-y-4 relative z-10">
                                <div class="flex justify-between items-center py-2 border-b border-black/10">
                                    <span class="text-black/70 text-sm">Subtotal Est.</span>
                                    <span class="font-bold">$12,450.00</span>
                                </div>
                                <div class="flex justify-between items-center py-2 border-b border-black/10">
                                    <span class="text-black/70 text-sm">Prioridad (Alta)</span>
                                    <span class="font-bold">+$1,200.00</span>
                                </div>
                                <div class="flex justify-between items-center py-2 border-b border-black/10">
                                    <span class="text-black/70 text-sm">IVA (16%)</span>
                                    <span class="font-bold">$2,184.00</span>
                                </div>
                                <div class="flex justify-between items-center pt-4 pb-2">
                                    <span class="text-lg text-black/80">Total Estimado</span>
                                    <span class="text-2xl font-bold">$15,834.00</span>
                                </div>
                            </div>
                            <div class="mt-8 p-4 bg-black/5 rounded-xl border border-black/10">
                                <div class="flex items-center gap-3 mb-2">
                                    <span class="material-symbols-outlined">calendar_today</span>
                                    <span class="text-xs uppercase tracking-widest font-bold">Fecha de Entrega</span>
                                </div>
                                <p class="text-xl font-bold">24 Octubre, 2023</p>
                                <p class="text-[10px] opacity-70 mt-1 font-medium">Sujeto a disponibilidad de materia prima</p>
                            </div>
                        </section>
                        <!-- Action Buttons -->
                        <div class="space-y-3">
                            <button class="w-full py-4 bg-black text-white rounded-xl font-bold text-lg shadow-lg hover:opacity-90 active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                                <span class="material-symbols-outlined">assignment_turned_in</span>
                                Pedido Finalizado
                            </button>
                            <button class="w-full py-3 bg-white text-on-surface border-2 border-primary rounded-xl font-bold hover:bg-primary/10 transition-all flex items-center justify-center gap-2">
                                <span class="material-symbols-outlined">save</span>
                                Guardar Borrador
                            </button>
                            <button class="w-full py-2 text-on-surface-variant font-medium hover:text-error transition-colors flex items-center justify-center gap-2">
                                <span class="material-symbols-outlined text-sm">delete</span>
                                Descartar Cambios
                            </button>
                        </div>
                        <!-- Mini Image Card -->
                        <div class="bg-surface-container-high rounded-xl overflow-hidden border border-outline-variant">
                            <div class="h-32 w-full relative">
                                <img class="w-full h-full object-cover" data-alt="A macro close-up of a master carpenter's hands smoothing a piece of high-quality raw oak" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAa7eOTCVrg_71DrJ-bvY3vF1g8KM6wIXptZGOUam60A-hZlWjO_nnQq_2rxZfvwL4XRwzjTdERkQ9JuThdXtuTcuKanBIjIUOLpsZsvf3Yf1O2Rrm2y825pp42ToRh78KiRWk4u5gLXk40hjhXOQ7gnVdnqIIM20Y3DL6Lag5Ux694Gf_kk28HbeH0xvaddJ5nl7qM482knN25Z4IABqOUwC0ArnGckVRdl588F8FBjDWTEIR8e6HeRw" />
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex items-end p-4">
                                    <span class="text-white text-xs font-bold uppercase tracking-widest">Inspiración de Acabado</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <!-- Floating Micro Interaction for Success -->
    <div class="fixed bottom-8 left-1/2 -translate-x-1/2 bg-black text-white py-3 px-6 rounded-full shadow-2xl flex items-center gap-3 transition-all duration-500 transform opacity-0 pointer-events-none translate-y-10" id="toast">
        <span class="material-symbols-outlined text-primary">check_circle</span>
        <span class="font-medium">El borrador ha sido guardado automáticamente</span>
    </div>
    <script>
            let timeout;
            document.querySelectorAll('input, select, textarea').forEach(el => {
                el.addEventListener('input', () => {
                    clearTimeout(timeout);
                    timeout = setTimeout(() => {
                        const toast = document.getElementById('toast');
                        toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-10');
                        setTimeout(() => {
                            toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-10');
                        }, 3000);
                    }, 2000);
                });
            });
    </script>
    <div aria-hidden="true" data-snapdom-sandbox="true" id="snapdom-sandbox" style="position: absolute; left: -9999px; top: -9999px; width: 0px; height: 0px; overflow: hidden;"></div></body>
</html>