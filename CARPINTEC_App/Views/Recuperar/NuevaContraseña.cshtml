@{
    Layout = null;
    ViewData["Title"] = "Nueva Contraseña";
}

<!DOCTYPE html>
<html lang="es">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Nueva Contraseña - Carpintec</title>

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: Arial;
            }

            body {
                background: url('/img/fondoLogin.jpg');
                background-size: cover;
                background-position: center;
                display: flex;
                justify-content: center;
                align-items: center;
                height: 100vh;
            }

            .card {
                width: 430px;
                background: white;
                padding: 35px;
                border-radius: 12px;
                box-shadow: 0 0 20px rgba(0,0,0,.3);
            }

            h2 {
                text-align: center;
                color: #8b4513;
                margin-bottom: 10px;
            }

            p {
                text-align: center;
                color: gray;
                margin-bottom: 25px;
            }

            label {
                font-weight: bold;
                display: block;
                margin-bottom: 6px;
            }

            /* =========================
                       CONTENEDOR DE CONTRASEÑA
                       ========================= */

            .password-wrapper {
                position: relative;
                width: 100%;
                margin-bottom: 18px;
            }

                .password-wrapper input {
                    width: 100%;
                    padding: 12px 45px 12px 12px;
                    border: 1px solid #ccc;
                    border-radius: 6px;
                    margin-bottom: 0;
                }

            /* =========================
                       BOTÓN DEL OJO
                       ========================= */

            .toggle-password {
                position: absolute;
                right: 10px;
                top: 50%;
                transform: translateY(-50%);
                width: auto;
                padding: 5px;
                background: transparent;
                color: #777;
                border: none;
                border-radius: 0;
                font-size: 20px;
                cursor: pointer;
            }

                .toggle-password:hover {
                    background: transparent;
                    color: #8b4513;
                }

            /* =========================
                       BOTÓN CAMBIAR CONTRASEÑA
                       ========================= */

            .btn-cambiar {
                width: 100%;
                padding: 14px;
                background: #8b4513;
                color: white;
                border: none;
                border-radius: 6px;
                font-size: 17px;
                cursor: pointer;
            }

                .btn-cambiar:hover {
                    background: #6d3510;
                }

            /* =========================
                       MENSAJES
                       ========================= */

            .mensajeError {
                background: #ffd6d6;
                color: #b30000;
                padding: 12px;
                border-radius: 6px;
                text-align: center;
                margin-bottom: 20px;
            }

            .mensajeOk {
                background: #d9ffe2;
                color: green;
                padding: 12px;
                border-radius: 6px;
                text-align: center;
                margin-bottom: 20px;
            }

    </style>

</head>

<body>

    <div class="card">

        <h2>Nueva Contraseña</h2>

        <p>
            Ingrese una nueva contraseña para su cuenta.
        </p>

        @if (TempData["Error"] != null)
        {
            <div class="mensajeError">
                @TempData["Error"]
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="mensajeOk">
                @TempData["Success"]
            </div>
        }

        <form asp-controller="Recuperar"
              asp-action="GuardarNuevaContraseña"
              method="post">

            <!-- =========================
                 NUEVA CONTRASEÑA
                 ========================= -->

            <label>Nueva contraseña</label>

            <div class="password-wrapper">

                <input type="password"
                       id="password"
                       name="password"
                       minlength="8"
                       placeholder="Ingrese la nueva contraseña"
                       required />

                <button type="button"
                        class="toggle-password"
                        onclick="togglePassword('password', this)"
                        aria-label="Mostrar contraseña">
                    👁
                </button>

            </div>


            <!-- =========================
                 CONFIRMAR CONTRASEÑA
                 ========================= -->

            <label>Confirmar contraseña</label>

            <div class="password-wrapper">

                <input type="password"
                       id="confirmarPassword"
                       name="confirmarPassword"
                       minlength="8"
                       placeholder="Confirme la contraseña"
                       required />

                <button type="button"
                        class="toggle-password"
                        onclick="togglePassword('confirmarPassword', this)"
                        aria-label="Mostrar contraseña">
                    👁
                </button>

            </div>


            <!-- =========================
                 BOTÓN
                 ========================= -->

            <button type="submit"
                    class="btn-cambiar">
                Cambiar Contraseña
            </button>

        </form>

    </div>


    <!-- =========================
         JAVASCRIPT
         ========================= -->

    <script>

            function togglePassword(inputId, button) {

                const input =
                    document.getElementById(inputId);

                if (input.type === "password") {

                    input.type = "text";

                    button.textContent = "🙈";

                    button.setAttribute(
                        "aria-label",
                        "Ocultar contraseña"
                    );

                } else {

                    input.type = "password";

                    button.textContent = "👁";

                    button.setAttribute(
                        "aria-label",
                        "Mostrar contraseña"
                    );
                }
            }

    </script>

</body>
</html>