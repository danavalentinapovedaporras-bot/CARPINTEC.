<script>
        const form = document.getElementById('quote-form');
        const woodTypeSelect = document.getElementById('wood-type');
        const quantityInput = document.getElementById('quantity');
        const displayUnitPrice = document.getElementById('display-unit-price');
        const displaySubtotal = document.getElementById('display-subtotal');
        const displayDiscount = document.getElementById('display-discount');
        const resumenTotal = document.getElementById('resumen-total');

        // Fixed labor cost for this demonstration
        const fixedLabor = 120000;

        function formatCurrency(value) {
            return '$' + value.toLocaleString('es-CO');
        }

        function calculateValues() {
            const unitPrice = parseInt(woodTypeSelect.value);
            const quantity = Math.max(1, parseInt(quantityInput.value) || 1);

            const subtotal = unitPrice * quantity;
            const discount = Math.round(subtotal * 0.05);
            const total = subtotal + fixedLabor - discount;

            // Update UI
            displayUnitPrice.innerText = formatCurrency(unitPrice);
            displaySubtotal.innerText = formatCurrency(subtotal);
            displayDiscount.innerText = '-' + formatCurrency(discount);
            resumenTotal.innerText = formatCurrency(total);
        }

        // Input Events
        woodTypeSelect.addEventListener('change', calculateValues);
        quantityInput.addEventListener('input', calculateValues);

        // Quantity Stepper
        document.getElementById('qty-plus').onclick = () => {
            quantityInput.value = parseInt(quantityInput.value) + 1;
            calculateValues();
        };
        document.getElementById('qty-minus').onclick = () => {
            if (parseInt(quantityInput.value) > 1) {
                quantityInput.value = parseInt(quantityInput.value) - 1;
                calculateValues();
            }
        };

        // Form Submission Handling
        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            const originalContent = btn.innerHTML;

            btn.innerHTML = `
                    <span class="material-symbols-outlined animate-spin" data-icon="progress_activity">progress_activity</span>
                    PROCESANDO...
                `;
            btn.disabled = true;

            setTimeout(() => {
                btn.innerHTML = `
                        <span class="material-symbols-outlined" data-icon="check_circle">check_circle</span>
                        COTIZACIÓN CREADA
                    `;
                btn.classList.replace('bg-primary', 'bg-green-700');

                setTimeout(() => {
                    btn.innerHTML = originalContent;
                    btn.classList.replace('bg-green-700', 'bg-primary');
                    btn.disabled = false;
                }, 3000);
            }, 1500);
        });

        // Initial calculation
        calculateValues();
</script>




</body></html>