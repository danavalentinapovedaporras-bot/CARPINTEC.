<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CARPINTEC</title>
    <div class="text-center mb-4">
        <img src="~/img/logo.png" width="80" class="mb-2" />
        <h4 class="fw-bold">CARPINTEC</h4>
    </div>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <div class="d-flex">

        <!-- Sidebar -->
        <div class="p-3" style="width:270px; min-height:100vh; background-color:#D2B48C;">

            <<h3 class="text-center mb-4">
                CARPINTEC
            </h3>

            <ul class="nav flex-column">

                <!-- Dashboard -->
                <li class="nav-item mb-3">
                    <a class="nav-link text-white" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>

                <!-- Administración -->
                <small class="text-uppercase text-secondary fw-bold">

                    Administración
                </small>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Usuarios" asp-action="Index">
                        <i class="bi bi-people-fill"></i> Gestión de usuarios
                    </a>
                </li>

                <li class="nav-item mb-3">
                    <a class="nav-link text-white" asp-controller="Empleados" asp-action="Index">
                        <i class="bi bi-person-badge-fill"></i> Gestión de empleados
                    </a>
                </li>

                <!-- Gestión Comercial -->
                <small class="text-uppercase text-light fw-bold mt-2 mb-2">
                    Gestión Comercial
                </small>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Clientes" asp-action="Index">
                        <i class="bi bi-person-lines-fill"></i> Gestión de clientes
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Cotizaciones" asp-action="Index">
                        <i class="bi bi-file-earmark-text"></i> Cotizaciones
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Pedidos" asp-action="Index">
                        <i class="bi bi-cart-fill"></i> Pedidos
                    </a>
                </li>

                <li class="nav-item mb-3">
                    <a class="nav-link text-white" asp-controller="Ventas" asp-action="Index">
                        <i class="bi bi-cash-stack"></i> Ventas y facturación
                    </a>
                </li>

                <!-- Producción -->
                <small class="text-uppercase text-light fw-bold mt-2 mb-2">
                    Producción
                </small>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Productos" asp-action="Index">
                        <i class="bi bi-box-seam"></i> Productos
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Inventario" asp-action="Index">
                        <i class="bi bi-boxes"></i> Inventario
                    </a>
                </li>

                <li class="nav-item mb-3">
                    <a class="nav-link text-white" asp-controller="ManoObra" asp-action="Index">
                        <i class="bi bi-hammer"></i> Mano de obra
                    </a>
                </li>

                <!-- Reportes -->
                <small class="text-uppercase text-light fw-bold mt-2 mb-2">
                    Reportes y soporte
                </small>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Reportes" asp-action="Index">
                        <i class="bi bi-bar-chart-fill"></i> Reportes
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="PQR" asp-action="Index">
                        <i class="bi bi-chat-left-dots-fill"></i> PQR
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Ayuda" asp-action="Index">
                        <i class="bi bi-robot"></i> Ayuda / Chatbot
                    </a>
                </li>

                <li class="nav-item mb-3">
                    <a class="nav-link text-white" asp-controller="Configuracion" asp-action="Index">
                        <i class="bi bi-gear-fill"></i> Configuración
                    </a>
                </li>

                <hr>

                <a class="btn btn-danger w-100 mt-3"
                   asp-controller="Login"
                   asp-action="CerrarSesion">
                    <i class="bi bi-box-arrow-right"></i>
                    Cerrar sesión
                </a>

            </ul>

        </div>

        <!-- Contenido -->
        <div class="flex-grow-1">

            <nav class="navbar navbar-light bg-light shadow-sm px-4">
                <h4 class="mb-0">@ViewData["Title"]</h4>
            </nav>

            <div class="container-fluid mt-4">
                @RenderBody()
            </div>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>