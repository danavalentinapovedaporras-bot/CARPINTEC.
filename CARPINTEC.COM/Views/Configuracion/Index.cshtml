                            "outline-variant": "#d1c5b8",
                            "secondary": "#5f5e5e",
                            "on-secondary": "#ffffff",
                            "tertiary": "#525f76",
                            "on-tertiary": "#ffffff",
                            "error": "#ba1a1a",
