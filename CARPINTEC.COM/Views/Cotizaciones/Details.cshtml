@model CARPINTEC.COM.Models.Cotizacion

@{
    Layout = null;
    ViewData["Title"] = "Detalle de Cotización";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Detalle de Cotización</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            body {
                margin: 0;
                padding: 40px;
                background: #f5f5f5;
                font-family: Arial, Helvetica, sans-serif;
            }

            .cotizacion {
                max-width: 900px;
                margin: auto;
                background: white;
                padding: 40px;
                border-radius: 10px;
                box-shadow: 0 0 15px rgba(0,0,0,.15);
            }

            h2 {
                text-align: center;
                margin-bottom: 30px;
            }

            table {
                width: 100%;
            }

            td {
                padding: 12px;
                border-bottom: 1px solid #ddd;
            }

            .acciones {
                margin-top: 30px;
                text-align: center;
            }
    </style>

</head>

<body>

    <div class="cotizacion">

        <h2>Detalle de la Cotización</h2>

        <table>

            <tr>
                <td><strong>Folio</strong></td>
                <td>@Model.Folio</td>
            </tr>

            <tr>
                <td><strong>Cliente</strong></td>
                <td>@Model.IdClienteNavigation.Nombre</td>
            </tr>
           
            <tr>
                <td><strong>Empleado</strong></td>
                <td>@Model.IdEmpleadoNavigation.Nombre @Model.IdEmpleadoNavigation.Apellido</td>
            </tr>
           
            <tr>
                <td><strong>Fecha</strong></td>
                <td>@Model.Fecha</td>
            </tr>

            <tr>
                <td><strong>Total</strong></td>
                <td>@Model.Total.ToString("C")</td>
            </tr>

            <tr>
                <td><strong>Estado</strong></td>
                <td>@Model.Estado</td>
            </tr>

            <tr>
                <td><strong>Observaciones</strong></td>
                <td>@Model.Observaciones</td>
            </tr>

        </table>

        <div class="acciones">

            <a asp-action="Edit"
               asp-route-id="@Model.IdCotizacion"
               class="btn btn-warning">
                Editar
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Volver
            </a>

        </div>

    </div>

</body>
</html>