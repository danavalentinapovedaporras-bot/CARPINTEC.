<script>
        function switchTab(type) {
            const activosBtn = document.getElementById('tab-activos');
            const finalizadosBtn = document.getElementById('tab-finalizados');
            const orders = document.querySelectorAll('.order-item');
            const emptyState = document.getElementById('empty-state');

            let visibleCount = 0;

            if (type === 'activos') {
                activosBtn.classList.add('bg-primary', 'text-on-primary', 'shadow-sm');
                activosBtn.classList.remove('text-on-surface-variant', 'hover:bg-surface-container-highest');
                finalizadosBtn.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm');
                finalizadosBtn.classList.add('text-on-surface-variant', 'hover:bg-surface-container-highest');

                orders.forEach(order => {
                    if (order.classList.contains('active')) {
                        order.classList.remove('hidden');
                        visibleCount++;
                    } else {
                        order.classList.add('hidden');
                    }
                });
            } else {
                finalizadosBtn.classList.add('bg-primary', 'text-on-primary', 'shadow-sm');
                finalizadosBtn.classList.remove('text-on-surface-variant', 'hover:bg-surface-container-highest');
                activosBtn.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm');
                activosBtn.classList.add('text-on-surface-variant', 'hover:bg-surface-container-highest');

                orders.forEach(order => {
                    if (order.classList.contains('finished')) {
                        order.classList.remove('hidden');
                        visibleCount++;
                    } else {
                        order.classList.add('hidden');
                    }
                });
            }

            if (visibleCount === 0) {
                emptyState.classList.remove('hidden');
                emptyState.classList.add('flex');
            } else {
                emptyState.classList.add('hidden');
                emptyState.classList.remove('flex');
            }
        }
</script>
