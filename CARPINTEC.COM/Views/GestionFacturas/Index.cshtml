        <script>
                // Smooth scroll reveal logic for micro-interactions
                window.addEventListener('scroll', () => {
                    const header = document.querySelector('header');
                    if (window.scrollY > 50) {
                        header.classList.add('py-2', 'md:py-2');
                        header.classList.remove('py-sm');
                        header.querySelector('.md\\:h-20').classList.remove('md:h-20');
                        header.querySelector('.md\\:h-16')?.classList.add('md:h-16');
                    } else {
                        header.classList.remove('py-2', 'md:py-2');
                        header.classList.add('py-sm');
                    }
                }

                // Simple animation trigger for progress bars on load
                document.addEventListener('DOMContentLoaded', () => {
                    const bars = document.querySelectorAll('.h-full.rounded-full');
                    bars.forEach(bar => {
                        const targetWidth = bar.style.width;
                        bar.style.width = '0%';
                        setTimeout(() => {
                            bar.style.width = targetWidth;
                        }, 400);
                    });
                });
        </script>

