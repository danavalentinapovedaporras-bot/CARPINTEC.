        <meta charset="utf-8">
    </head>
    <body class="bg-surface overflow-x-hidden min-h-screen">
        <!-- Top AppBar -->
        <header class="fixed top-0 left-0 right-0 z-[100] bg-surface shadow-sm transition-all duration-300">
            <div class="max-w-7xl mx-auto px-margin py-sm flex justify-between items-center h-16 md:h-20">
                <div class="flex items-center gap-4">
                    <button class="md:hidden p-2 rounded-full hover:bg-surface-container-high transition-colors active:scale-95">
                        <span class="material-symbols-outlined text-primary">menu</span>
                    </button>
                    <div class="flex items-center gap-2 group cursor-pointer">
                        <div class="w-10 h-10 bg-primary-container rounded-lg flex items-center justify-center group-hover:rotate-6 transition-transform">
                             <img src="~/images/logo.png" alt="Logo CARPINTEC" class="w-20 h-20 object-contain mb-2">
                        </div>
                        <span class="font-headline-md text-headline-md font-extrabold tracking-tight text-primary">Carpintec</span>
                    </div>
                </div>
                <nav class="hidden md:flex items-center gap-gutter">
                    <a href="#" class="font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors py-2 px-1 relative group">
                        Inventario
                        <span class="absolute bottom-0 left-0 w-full h-0.5 bg-primary scale-x-0 group-hover:scale-x-100 transition-transform origin-left"></span>
                    </a>
                    <a href="#" class="font-label-md text-label-md text-primary font-bold transition-colors py-2 px-1 relative">
                        Facturas
                        <span class="absolute bottom-0 left-0 w-full h-0.5 bg-primary"></span>
                    </a>
                    <a asp-controller="Proveedores"
                       asp-action="Index"
                       class="font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors py-2 px-1 relative group">
                        Proveedores
                        <span class="absolute bottom-0 left-0 w-full h-0.5 bg-primary scale-x-0 group-hover:scale-x-100 transition-transform origin-left"></span>
                    </a>
                    <a href="#" class="font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors py-2 px-1 relative group">
                        Ajustes
                        <span class="absolute bottom-0 left-0 w-full h-0.5 bg-primary scale-x-0 group-hover:scale-x-100 transition-transform origin-left"></span>
                    </a>
                </nav>
                <div class="flex items-center gap-3">
                    <div class="hidden sm:flex flex-col items-end mr-2">
                        <span class="font-label-md text-label-md text-on-surface font-bold">Admin</span>
                        <span class="text-[10px] text-on-surface-variant uppercase tracking-widest">Panel de Control</span>
                    </div>
                    <button class="w-10 h-10 rounded-full border-2 border-primary-fixed-dim overflow-hidden hover:scale-105 transition-transform">
