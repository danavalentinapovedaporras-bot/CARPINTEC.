@model CARPINTEC.COM.Models.Pqr

@{
    Layout = null;
    ViewData["Title"] = "Responder PQR";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Responder PQR</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
            body {
                background: #f5f5f5;
                padding: 40px;
            }

            .card {
                max-width: 900px;
                margin: auto;
                border: none;
                border-radius: 15px;
                box-shadow: 0 0 20px rgba(0,0,0,.15);
            }

            .card-header {
                background: #6f4e37;
                color: white;
                font-size: 24px;
                font-weight: bold;
            }

            textarea {
                min-height: 180px;
            }
    </style>
</head>

<body>

    <div class="card">

        <div class="card-header">
            Responder PQR
        </div>

        <div class="card-body">

            <form asp-action="Responder" method="post">

                <input type="hidden" asp-for="IdPqr" />

                <div class="mb-3">
                    <label class="form-label"><strong>Código</strong></label>
                    <input asp-for="CodigoPqr" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Cliente</strong></label>
                    <input class="form-control"
                           value="@Model.IdClienteNavigation.Nombre @Model.IdClienteNavigation.Apellido"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Tipo</strong></label>
                    <input asp-for="Tipo" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Asunto</strong></label>
                    <input asp-for="Asunto" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Descripción</strong></label>
                    <textarea class="form-control" readonly>@Model.Descripcion</textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Estado</strong></label>

                    <select asp-for="Estado" class="form-select">
                        <option>Pendiente</option>
                        <option>En proceso</option>
                        <option>Respondida</option>
                        <option>Cerrada</option>
                    </select>

                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Respuesta</strong></label>

                    <textarea asp-for="Respuesta"
                              class="form-control"
                              placeholder="Escriba aquí la respuesta al cliente..."></textarea>

                </div>

                <div class="text-end">

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-success">

                        Guardar Respuesta

                    </button>

                </div>

            </form>

        </div>

    </div>

</body>
</html>