<script>
        // Simple interactivity for feedback
        document.querySelectorAll('button, [cursor-pointer]').forEach(el => {
            el.addEventListener('click', function(e) {
                // Micro-interaction logic could be added here
                console.log('Action triggered:', this.innerText || 'Icon Button');
            });
        });

        // Sticky header opacity change on scroll
        window.addEventListener('scroll', () => {
            const header = document.querySelector('header');
            if (window.scrollY > 20) {
                header.classList.add('shadow-xl');
            } else {
                header.classList.remove('shadow-xl');
            }
        });
