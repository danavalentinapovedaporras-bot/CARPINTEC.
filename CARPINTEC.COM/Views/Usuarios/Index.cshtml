                            <tr class="hover:bg-surface-container-low transition-colors">
                                <td class="px-md py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-12 h-12 rounded-full overflow-hidden bg-surface-container border-2 border-outline-variant/20">
