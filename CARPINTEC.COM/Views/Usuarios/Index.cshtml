                                <td class="px-md py-4">
                                    <div class="flex items-center justify-end gap-2">
                                        <button class="p-2 text-outline hover:text-primary hover:bg-primary/10 rounded-lg transition-all" title="Ver detalles"><span class="material-symbols-outlined text-[20px]">visibility</span></button>
                                        <button class="p-2 text-outline hover:text-primary hover:bg-primary/10 rounded-lg transition-all" title="Editar"><span class="material-symbols-outlined text-[20px]">edit</span></button>
                                        <button class="p-2 text-outline hover:text-error hover:bg-error/10 rounded-lg transition-all" title="Desactivar"><span class="material-symbols-outlined text-[20px]">person_off</span></button>
