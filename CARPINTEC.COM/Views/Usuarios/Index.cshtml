                                        <div class="w-12 h-12 rounded-full overflow-hidden bg-surface-container border-2 border-outline-variant/20">
                                            <img class="w-full h-full object-cover" alt="Roberto Gómez" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCPvwa_tAzkrvuFkIjK7AiO9vj2ztAQtCEAG6fpGPPn-eWkgixA4o0ns5KX0_fPq-TkpjHp9qquRv9qIYLIQ0VwjemXtiDMydJqOUvhTU19TCOiZ8B2jyoSGoMznWwKMbYbNqnkz4GTlqS3rHQTYqTP3QOZM6zPnO4pIAeIUd3PY7744ohld1OZIRj6_0UusJwTHpHTNN5WXM8Tlt9Ng3P2GDQ7KSEyQc1XZfa_6A2iRwa8dkHBL4kP">
