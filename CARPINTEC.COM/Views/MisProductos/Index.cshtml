                        <div class="flex items-start justify-between">
                            <div>
                                <h4 class="font-title-md text-title-md text-primary mb-1">Biblioteca Estudio - Plan A</h4>
                                <p class="text-on-surface-variant font-label-md text-label-md">Cotización #4592 • Guardado hace 2 días</p>
                            </div>
                            <span class="material-symbols-outlined text-secondary cursor-pointer" data-icon="favorite" data-weight="fill">favorite</span>
                        </div>
                        <div class="mt-4 flex gap-4">
                            <button class="bg-primary text-on-primary px-6 py-2 font-label-md text-label-md hover:bg-secondary transition-all">Continuar Cotización</button>
                            <button class="border border-primary text-primary px-6 py-2 font-label-md text-label-md hover:bg-primary hover:text-on-primary transition-all">Ver Detalles</button>
                        </div>
                    </div>
                </div>
                <!-- Saved Item 2 -->
                <div class="flex flex-col md:flex-row items-center bg-surface-container p-6 gap-6 border-l-8 border-secondary relative overflow-hidden group">
                    <div class="w-full md:w-48 h-32 bg-surface-variant overflow-hidden flex-shrink-0">
                        <img class="w-full h-full object-cover" data-alt="A clean top-down view of various wood samples arranged neatly on a drafting table, including oak, walnut, and cherry wood. The samples show different stains and grains under bright, natural light. This setup represents the material selection phase for a high-end carpentry project in a modern architectural office." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDRcwj8CRMXZIU9XYNkqUAVQ9fZfeT-Qw5dcCNfoKxImxkWoTk9Lw6vU-KEpSHNa1bnmtbzpUXfWU5XRKwxJy5msBHvVi-RvSTXLvnSMV6LgF_OYXj40VyD4L4ofEtsMe0GQHNyM6YhFIkFnAx2l13SLrfN2TI0mpjvLYd-Oeg0Pa41jlREnVmz9qq3Mlie0179aUvNDZWAnPCwgizMOTijTZHnybWBhMTZGQynJMYKOWxqGkFE2STqQ9YuSMrgr6j8QxBZJSfQIrUA">
                    </div>
                    <div class="flex-grow">
                        <div class="flex items-start justify-between">
                            <div>
                                <h4 class="font-title-md text-title-md text-primary mb-1">Mueble TV Flotante - Cedro</h4>
                                <p class="text-on-surface-variant font-label-md text-label-md">Boceto de Cliente • Guardado hace 1 semana</p>
                            </div>
                            <span class="material-symbols-outlined text-secondary cursor-pointer" data-icon="favorite" data-weight="fill">favorite</span>
