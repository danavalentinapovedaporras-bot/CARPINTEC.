                        <p class="text-on-surface-variant font-body-md text-body-md mb-4">Estructura de fresno curvado al vapor y tejido artesanal de cuerda.</p>
                        <div class="flex items-center justify-between border-t border-outline-variant pt-4">
                            <span class="font-headline-lg-mobile text-headline-lg-mobile text-secondary">$420.00</span>
                            <button class="bg-primary text-on-primary p-2 flex items-center justify-center hover:bg-secondary transition-colors">
                                <span class="material-symbols-outlined" data-icon="add_shopping_cart">add_shopping_cart</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- Diseños Guardados Section -->
        <section class="mb-12">
            <div class="flex items-center justify-between mb-8">
