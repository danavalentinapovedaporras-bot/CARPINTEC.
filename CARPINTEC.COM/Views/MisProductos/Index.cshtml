                            <button class="bg-primary text-on-primary p-2 flex items-center justify-center hover:bg-secondary transition-colors">
                                <span class="material-symbols-outlined" data-icon="add_shopping_cart">add_shopping_cart</span>
                            </button>
                        </div>
                    </div>
                </div>
                <!-- Product Card 3 -->
                <div class="bg-surface-container-lowest border-2 border-outline-variant hover:wood-frame transition-all duration-300 group">
                    <div class="relative overflow-hidden aspect-[1.37] bg-surface-variant">
                        <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" data-alt="A minimalist solid wood chair with a woven rush seat, showcasing traditional joinery techniques. The chair is placed in a bright, airy architectural studio with natural light streaming through large windows. Warm earth tones and a professional corporate aesthetic define the scene." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDfkTdknNzPw815YgemnfYiwIhu5nkHmPuz_g_ITCDCLYWqXNwKR5ddmuh_6CAGfO1EaoC9yYTZi64gw1NVJnhGzVso1BS7rpCnl0qSjMQ2HncbmpeM34NSrpwrWYWKGvjJ9QiIPwJ98ar8pLcFJVaG8r1MZ40yLHiw4_A-gxvNNt1_TU595J3X95cYUENVWO-XRdzMPEgSzrDtKtjdQR9yUB5SPFrD9IGjxXjiAGX4BEfmifUZrOexCZ8WUrH2ZbJtdsXJ_8N8acZX">
                    </div>
