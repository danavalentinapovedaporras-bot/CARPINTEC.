    </main>
    <!-- BottomNavBar -->
    <nav class="bg-primary dark:bg-primary-container text-on-primary dark:text-on-primary-container font-label-md text-label-md docked full-width bottom-0 border-t-4 border-primary-container flat no shadows fixed bottom-0 w-full z-50 flex justify-around items-center px-2 py-3">
        <a class="flex flex-col items-center justify-center text-primary-fixed-dim hover:text-secondary-fixed transition-colors active:scale-95 transition-all duration-200" href="#">
            <span class="material-symbols-outlined" data-icon="home">home</span>
            <span class="">Inicio</span>
        </a>
        <a class="flex flex-col items-center justify-center bg-secondary-container text-on-secondary-container rounded-full px-4 py-1 active:scale-95 transition-all duration-200" href="#">
            <span class="material-symbols-outlined" data-icon="handyman">handyman</span>
            <span class="">Productos</span>
        </a>
        <a class="flex flex-col items-center justify-center text-primary-fixed-dim hover:text-secondary-fixed transition-colors active:scale-95 transition-all duration-200" href="#">
            <span class="material-symbols-outlined" data-icon="request_quote">request_quote</span>
            <span class="">Cotizaciones</span>
        </a>
        <a class="flex flex-col items-center justify-center text-primary-fixed-dim hover:text-secondary-fixed transition-colors active:scale-95 transition-all duration-200" href="#">
            <span class="material-symbols-outlined" data-icon="person">person</span>
            <span class="">Perfil</span>
        </a>
    </nav>
    <script>
            // Micro-interactions for hover effects and active states
            document.querySelectorAll('button, a').forEach(el => {
                el.addEventListener('mousedown', () => {
                    el.classList.add('scale-95');
                });
                el.addEventListener('mouseup', () => {
                    el.classList.remove('scale-95');
                });
                el.addEventListener('mouseleave', () => {
                    el.classList.remove('scale-95');
                });
            });
    </script>










</body></html>